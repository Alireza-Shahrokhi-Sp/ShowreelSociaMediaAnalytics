-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Gcq5JGhpeZoQ7kNvwFAEFV9&_nc_oc=AdpNhZvS3ePiou62kFvQ2AvR-yEadWxOh9zX9wLNcilJA9Y6J906Cn2XXHRZLpNMUbM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=RojPj2uU1X3A4ELG1U0Rcg&_nc_ss=7a22e&oh=00_Af-UTIE4BpldmhptfCRcJuQ-WIkqZiexr-F5J1NMZ0173A&oe=6A2622D6", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1440, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 84816, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17847486442994275", "bit_flags": 0, "created_at": 1584810647, "created_at_utc": 1584810647, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17847486442994275", "share_enabled": false, "content_type": "comment", "media_id": "2269877797250066488", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Il 21 Marzo del 2018 io e Romi eravamo in Vietnam e stavamo per intraprendere uno dei Trekking più faticosi della mia vita all’interno del parco nazionale di Phong Nha-Ke Bang. \nCon questo gruppo di ragazzi conosciuti sul posto, abbiamo dormito per giorni nella giungla vietnamita, attraversato dei fiumi con lo zaino in bilico sulla testa, nuotato nelle caverne più grandi e più profonde del mondo per poi trovarci la sera, seduti per terra e ancora inumiditi, a cantare canzoni nella lingua diversa di ognuno. \nNon mi sono mai più chiesta che fine abbia fatto Mary, la ragazza bionda dell’Inghilterra del nord, oppure Naomi e Alex, che della loro America non smettevano mai di raccontare a Katharina e Thomas, una coppia austriaca educata e silenziosa, che mai si sarebbe permessa di zittirli come invece ad un certo punto fece Emily, che io non potevo fare a meno di pensare fosse la power ranger rosa, ma non volesse dirlo a nessuno. \nNon ho mai saputo nulla di loro dopo quel viaggio, non ci siamo scambiati numeri o fotografie, come se il ricordo di quei giorni faticosi e irripetibili, fosse qualcosa da custodire segretamente. \nOra peró, forse, dove sono posso provare a immaginarlo, ognuno chiuso in casa propria a riguardare vecchie foto di vecchi viaggi per ingannare il tempo e non pensare alla realtà. Chissà se sono capitata anche io sotto il loro naso in questi giorni, mi piace pensare che quando tutto questo inferno sarà finito, saremo ancora tutti cosí stanchi, come in questa foto, ma forse, anzi senz’altro, molto più felici.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gFIbzavh_wEZ_HXIPzhFI7kPz5bT15v0l9JXpCBW_hfAYzx8ZL55B1E-MxTVUIAHbA&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=RojPj2uU1X3A4ELG1U0Rcg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9Q6Mi2QK3G3OhN-DkWWkrcNWV-eqo41ytt2OhmZDF6nA&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 155, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabl
111&ig_cache_key=MjE0MjgzNjg3NzQzNTIwMjMzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=m5HUXW2eNisQ7kNvwHYxbpG&_nc_oc=AdrIGISjMmUVz3jrpSad0c-uoXdqBnag9W6jtiB_PiMCA6AA59dZlcGVepUj8CoMfAI&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=KUu450wMlLH7thd1H_0mrQ&_nc_ss=7a22e&oh=00_Af8-YZsoqXKS8t4o6g-db9-TGmEYFi-xSoZV-LVlC8Un7g&oe=6A264246", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1799, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 103838, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17863900093503360", "bit_flags": 0, "created_at": 1569666085, "created_at_utc": 1569666085, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17863900093503360", "share_enabled": false, "content_type": "comment", "media_id": "2142836877435202333", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Qualche giorno fa sono andata a trovare la nonna Etta. Se c’è una cosa che ricordo molto bene della nonna Etta è la sua passione per le borse: ne aveva così tante che a contarle si faceva fatica; una cobalto, una vermiglio, una smeraldo, le sfoggiava con l’eleganza di chi ha ingannato il passare degli anni e io gliela leggevo proprio in faccia quella felicità bambinesca, quella frivola ma impagabile sensazione di riuscire sempre a trovare nell’armadio più alto la borsa perfetta, averne una di ogni colore era per lei la prova tangibile di una cura amorevole dedicatasi negli anni. \nVestite di tutto punto andavamo dunque a trovare il nonno al cimitero, il mio nonno Umberto, di cui ricordo solo l’accento toscano e il sorriso che ora indossa fiera mia madre; quando andavamo a trovarlo la nonna Etta sceglieva sempre i fiori più belli e li disponeva accanto a quelli che fino a quel momento gli avevan tenuto compagnia, una carezza che per lei valeva l’attesa di un’intera settimana; quel giardino di colori era la sua firma, come dire -vedi prima mi vedevi sempre indossare una borsa diversa ogni giorno e ora che non puoi più venire a spasso con me io i miei colori te li lascio qui, te li regalo- .\nQualche giorno fa, come dicevo, sono andata a trovare la nonna Etta, lei ormai non si ricorda più di quanto era bella con indosso tutte le sue molte borse, ma i colori spero che in qualche modo se li ricordi e che i fiori nel suo salotto le raccontino sempre, nonostante questa malattia nemica della memoria, di quel suo grande amore adorato.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHp1ze6vhvR9DvLeyeDnNmz74ziMgWhaBN8gu8CW8--AykKdyVE5mJKTiWdAv8JYlg&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=KUu450wMlLH7thd1H_0mrQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af87_EWaERCB0joYVu_51Pe8Dpd-s9dDXRPXW1FrqJrRcw&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 747, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "1552626
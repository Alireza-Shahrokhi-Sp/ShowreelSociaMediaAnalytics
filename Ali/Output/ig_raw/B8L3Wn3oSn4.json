n degli gnocchi e quando li trovo sul menù al ristorante non riesco a resistere con la conseguenza che spesso ordino due primi per provare cose nuove senza offendere la -mia- tradizione. Ogni tanto non riesco a finirli entrambi ma non mi sono mai fatta problemi a chiedere la doggy bag con l’avanzo: in Italia c’è ancora chi si intimidisce o ristoranti che non sono pronti a fornirla. #ilcibononsibutta mai, figuriamoci quando sono gnocchi al gorgonzola e noci. Pranzo servito!", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gE-OOBmOFagUabBp-TR4o2avza4CAi-1jdxg7LK0sOzT4myecrW0YNWD4f0EdPADxc&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=8DcDP5JR11_ncngC_uVhfw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9E54TJKcqyTgFbJ77wbVdkYFT0Tk7JucQ47yNWpt7v_Q&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 211, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "s
ntext_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 72296, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17848728178890014", "bit_flags": 0, "created_at": 1581433246, "created_at_utc": 1581433246, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17848728178890014", "share_enabled": false, "content_type": "comment", "media_id": "2241546569249745247", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Vi parlavo l’altro giorno dei miei due professori del liceo, quelli del cuore dico, che ricordo con grande nostalgia; alla fine ci siamo andati davvero a trovarli, io e miei  compagni di classe di allora che poi sono i migliori amici di oggi, non ci è sembrato passato neanche un giorno nei loro occhi, eppure ne son trascorsi almeno 3650. \nGli anni dei mio liceo sono stati tremendi e bellissimi, non li rifarei neanche per tutto l’oro del mondo, ma quanto mi piacerebbe seguirle ora quelle lezioni e quanto ancora mi emoziona, a distanza di dieci anni, sentire qualcuno urlare da lontano: “salve prof”, sguaiato come lo urlavo io allora e come ogni tanto, se mi fermo e ci penso, vorrei urlarlo oggi.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGV_sln9OiaJ5RilsM_lzuVB2ud79Un1-1H5dtHz0kgCKaTCBzBJZJD6ZHwl93EaBk&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=RQjve4mTXf0g7Zzg3-GerQ&edm=ALQROFkBAAAA&ccb=7-5&oh
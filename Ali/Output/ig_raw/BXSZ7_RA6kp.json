.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gGE0JECQJCSpJ1EsIeNlq1E49vnjnjbd-IBAqQir7ApYGS8u1mKPn6joIH0TZFsXnE&_nc_ohc=5swOI-2rSp4Q7kNvwGe3XK1&_nc_gid=dW6-YSVvc04S-MQRX4tZPg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_L9rfSqQw7wllolQGiQxv2xYF88u6W6xQwrabMAbVGNg&oe=6A26363C&_nc_sid=fc8dfb", "width": 150}]}, "original_width": 720, "original_height": 900, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 39870, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17907619300068388", "bit_flags": 0, "created_at": 1513115689, "created_at_utc": 1513115689, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17907619300068388", "share_enabled": false, "content_type": "comment", "media_id": "1572433293448816937", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Ero piccola ma abbastanza grande da poter ricordare che quando la nonna Benedetta - chiamata da tutti nonna Etta anche se non è mica la nonna di tutti ma solo la mia - quando la mia nonna, correggo, veniva a prendermi a scuola mi portava sempre una cosina. \nLa chiamava proprio così lei: La Cosina. \nE credo la chimasse così per darle costanza senza troppe aspettative; anche se io ce l'ho stampato quanto era felice, dopo, quando le correvo incontro e spalancando la bocca sopresa gridavo sempre ma dico sempre: nonna me l'hai portata La Cosina? Lo chiedevo solo pro forma perchè sapevo benissimo che La Cosina non mancava mai e a ben vedere sapevo pure che era quasi sempre cioccolato ma avevo accettato di buon grando di fingere stupore in cambio di quella merenda extra che mamma non mi avrebbe mai concesso. \nLa nonna Etta era un'insegnante di italiano e quando -come vi dicevo -mi veniva a prendere pilotando la sua Clio rossa, mi faceva fare il gioco delle pertinenze. \nSapete cos'è il gioco delle pertinenze?\nAd esempio io avevo sei anni lei mi disse acqua io le risposi ossigeno e lei mica se lo aspettava infatti disse subito stasera lo diciamo alla mamma quanto sei forte. \nPerò io la sera gliel'ho comunque ricordato alla nonna, di dire alla mamma quanto ero forte. \nLa nonna Etta sono ormai cinque anni che ha una grave forma di Alzheimer e che al gioco delle pertinenze non ci sa giocare più. \nA lei ora piace cantare e più invecchia più torna bambina. \nLa nonna Etta come me la ricordo io non la rivedrò più, ma ogni tanto mi piace pensare che beffarda e scanzonata stia facendo tutto apposta. \nCome a dirmi uèi guarda che ora è il mio turno, me l'hai portata La Cosina?", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGE0JECQJCSpJ1EsIeNlq1E49vnjnjbd-IBAqQir7ApYGS8u1mKPn6joIH0TZFsXnE&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=dW6-YSVvc04S-MQRX4tZPg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af8G2Z_wJERCeT6SkqIwvYlXevv5MI6KgYbnURAp1F2Xtg&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 454, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "video_duration": 33.34299850463867, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema
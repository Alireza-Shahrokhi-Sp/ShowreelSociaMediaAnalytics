5/527537617_731324546545831_2225997100564673520_n.jpg?stp=c236.0.607.607a_dst-jpg_e15_s150x150_tt6&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=107&_nc_oc=Q6cZ2gHqjKHM0LGgnapGD8EIlhjHjBfFwHM8D1LlFY_opcLNWFzxfvuVyBBLOUbz_-JKErw&_nc_ohc=xTeBG6L7aiQQ7kNvwFcy6xR&_nc_gid=eELeaqB9SKLXn9Zc6j92Uw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-5FdEea6ETaFGg2KJAqa2Qs8c8MjmreRUZ0vOow1-Xjw&oe=6A262953&_nc_sid=fc8dfb", "width": 150}]}, "original_width": 960, "original_height": 540, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 15912, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17853914989219985", "bit_flags": 0, "created_at": 1513671877, "created_at_utc": 1513671877, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17853914989219985", "share_enabled": false, "content_type": "comment", "media_id": "1672548894388760464", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Se ripenso alla mia adolescenza posso dire di essere stata una di quelle ragazze che alle feste la sera ci andava davvero poco e questo perchè la mia mamma e il mio papà non erano mica tanto d’accordo con questa idea del tornare tardi e devo dire che ho sempre accettato di buon grado la cosa col risultato che quando succedeva che a queste feste dei giovani io ci potevo andare davvero ero tanto emozionata e quindi, per una questione che mi piace pensare non sia solo statistica, queste feste me le ricordo proprio tutte. \nMi ricordo anche che al ritorno, quando non c’era il mio papà che si chiama Marco, infilandosi i pantaloni sopra il pigiama, ci veniva a prendere il papà di Paola che poi è una delle mie amiche del cuore ancora oggi pure se non glielo scrivo più sulla prima pagina della smemo. \nSuccedeva che nel tragitto in macchina verso casa, al ritorno, suo babbo ci metteva sempre la stessa canzone, che era una delle sue preferite, e noi ci si rilassava cosí tanto con quelle note che ci si dimenticava di ricordarci di non metterli più quei tacchi che ci rendevano forse più grandi ma terribilmente sofferenti. \nOra il babbo di Paola non viene più a prenderci alle feste perché siamo diventate grandi e alle feste, a dire il vero, non ci andiamo quasi più perchè abbiamo sempre sonno, ma quella canzone, quella che ci metteva il suo babbo in macchina dico, ieri ce la siamo riascoltata insieme io e paola e lei per l’occasione ha rimesso pure i tacchi.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuZXhwZXJpbWVudGFsIn0&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHqjKHM0LGgnapGD8EIlhjHjBfFwHM8D1LlFY_opcLNWFzxfvuVyBBLOUbz_-JKErw&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=eELeaqB9SKLXn9Zc6j92Uw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af8NAveeOsfuDSjZhrK2BKDFVdYeyYMt-0CdhhlCUq8NmQ&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 159, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "video_duration": 60.11600112915039, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"u
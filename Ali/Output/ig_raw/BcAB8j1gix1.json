agram.com&_nc_gid=_Xh4W7ixF_9Xds_V5eurQw&_nc_ss=7a22e&oh=00_Af-_egMUoO0rpjYKfeoMxTPPsQKPH7o4kN9X_9AAdGNyNA&oe=6A26354E", "width": 640, "is_spatial_image": false}]}, "original_width": 1080, "original_height": 1080, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 74424, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17897106913098384", "bit_flags": 0, "created_at": 1511789603, "created_at_utc": 1511789603, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17897106913098384", "share_enabled": false, "content_type": "comment", "media_id": "1657333222566145141", "status": "Active", "type": 1, "user_id": "15526265", "text": "È vero che io rido sempre molto ma per esempio l’anno scorso è stato proprio un periodo nero perchè niente sembrava combaciare con l’idea che avevo di me stessa e con le proiezioni che avevo disegnato per il mio futuro fino ad allora. \nÈ stato quando ho notato che perdevo davvero tanto tempo a fare questa cosa qui, a piangere dico, che ho deciso di fotografare ogni momento che sprecavo a non fare qualcosa di concreto per cambiare direzione. \nQueste sono solo alcune delle centinaia di foto che nell’ultimo anno ho salvato nella cartella “POI TI SPIEGO”. L’ho chiamata cosi perchè sapevo sarebbe arrivato un giorno, che poi è oggi, in cui le avrei guardate e avrei capito che anno terribile e bellissimo è stato e quanto sono felice oggi e quanto me lo sono meritato. \nRiassunto per chi non ha voglia di leggere: robe tumblr random + fatevi una doccia e uscite che è una bella giornata.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is
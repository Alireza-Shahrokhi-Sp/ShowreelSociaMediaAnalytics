68, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17912819512157058", "bit_flags": 0, "created_at": 1525034541, "created_at_utc": 1525034541, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17912819512157058", "share_enabled": false, "content_type": "comment", "media_id": "1732658666898944050", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Amici benvenuti alla prima puntata dell’originalissimo format #ceneumili: consigli umili su dove mangiare bene se non avete l’american express. \nPrima che arrivi la querela da Borghese volevo dirvi che le foto fanno davvero schifo ma diventerò una brava fotografa di cose da mangiare ve lo prometto. \nPrima tappa del tour: u barba, Milano. \nLochescio: 8/10 \nDecisamente hipster milanese ma molto carino: biciclette appese alle pareti e lampade da scrivania su tavoli di legno. Nb: i tavoli da due sono meravigliosi perchè lunghi ma stretti cosi se siete dirimpettai potete darvi i baci. \nCibo: 8/10 \nCucina tipica ligure, menù con grazie al cielo pochi piatti a rotazione settimanale. La loro focaccia al formaggio è il classico antipasto che chiedi poi anche come primo, secondo e dolce. Testaroli al pesto buonissimi ma ancora più buoni se evitate le cinque porzioni di focaccia al formaggio di cui poc’anzi arrivando al primo già bisognosi di lavanda gastrica. \nNon sono arrivata al dolce perchè mi hanno portato via in barella. \nUmiltà: 7/10\nDue antipasti, due primi, mezzo litro di vino rosso in brocca, acqua e due caffè (con amaro offerto) a 30€ a testa. Perfettamente in linea con la media milanese quindi direi abbastanza umili (tiramisù a 6,00 euro peró un po’ poco umile)e aggiungo che li paghi tutti volentieri perchè il personale è adorabile e alla fine della cena mi hanno anche regalato un canovaccio da cucina bellissimo. \nRiassunto: sono una ragazza semplice se mi danno la focaccia sporco la tovaglietta di olio e ormai è troppo tardi per fare la foto ma qui iderne verità e quindi ACAB. #receumile", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGwQJKROd4iaO1p62QkSp2BIwMfvTVdomg8YFanmfaFTfShxTKILyfIOdte0D1PgHI&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=iFt346-AC2PUdW6ymDa7_A&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_2QyHZeZPAehhlKyPiiFeo1jAeTvpozFyUEQX16-tlMw&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 194, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_s
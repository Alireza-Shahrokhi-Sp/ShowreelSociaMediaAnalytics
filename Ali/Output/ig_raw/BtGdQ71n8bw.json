t-jpg_e35_s640x640_sh2.08_tt6&_nc_cat=102&ig_cache_key=MTk2NTM4Njk5NDUwNDY4MTIwMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTA4MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=7fTrfNTOlcIQ7kNvwFR-Tsm&_nc_oc=AdqE697YiQbAh5T4yLmMH0eTGBt0me0OUr3oHki-CzCj5sbCS4s65ay4OxTDITiDvyA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=dMKWyBmjWMUNbKUW8YC4gA&_nc_ss=7a22e&oh=00_Af-jUW4hl_EMjJhPdT-Satg9vxNNdB41Z7neTCTLq4UFtQ&oe=6A2657A8", "width": 640, "is_spatial_image": false}]}, "original_width": 1080, "original_height": 749, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 109418, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17847573946347753", "bit_flags": 0, "created_at": 1548512726, "created_at_utc": 1548512726, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17847573946347753", "share_enabled": false, "content_type": "comment", "media_id": "1965386994504681200", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "In questi giorni sto sfruttando il più possibile i miei umili mezzi di comunicazione per sottolineare ancora una volta l’importanza di NON USARE MAI il cellulare mentre si guida, tanto meno per fare instagram stories. \nPer quanto le strade siano deserte, per quanto si abbia un supporto a cui agganciare il telefono, per quanto si ritenga che la situazione sia sotto il nostro totale controllo, usare il telefono alla guida diminuirà sempre, in percentuale variabile, la nostra attenzione. Errare è umano, a tutti sarà capitato di usare il cellulare in macchina almeno una volta, a me per prima. Ció che credo sia davvero importante è fare un grande e contagioso sforzo comune nel demonizzarne l’utilizzo, dando il buon esempio e invitando gli altri a fare lo stesso. \nTeniamo sempre presente che quando valutiamo se una situazione è rischosa o meno entra sempre in atto quella che tecnicamente viene definita l'euristica della disponibilità, ovvero quella strategia cognitiva che stima la probabilità di un evento sulla base della nostra esperienza diretta e dell'impatto emotivo del suo ricordo, piuttosto che sulla reale probabilità oggettiva che l'evento in questione si verifichi. \nQuesto per dire che nessuno di noi mentre usa il cellulare, pur giudicandosi in piena sicurezza, lo è davvero; e ció è ancor più grave se consideriamo che la vostra personale accettazione del rischio, che potrebbe essere legittima in una strada di vostra proprietà e percorsa sempre e solo da voi, in realtà metta a repetaglio anche la sicurezza degli altri nella quasi totalità dei casi ovvero sulle strade comuni. \nQuesto pippone infinito solo per chiedervi di fare uno sforzo: mettete via i telefoni, #NOIGSTORIESWHILEDRIVING, se non per amor proprio almeno per le persone a cui siete affezionati che vi posso garantire percorrono le stesse strade vostre. \nFoto di me col bolide che sfreccia i 45.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gF_mr_NFSKKCx9VwcLOr7EyLmKLAFHWTdrcjkxqOWlTUWTLkj3qag-OM_byprsxo8I&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=dMKWyBmjWMUNbKUW8YC4gA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_0FcGSdD4OWo7n96fWE0WZ5TRtnoLe5UOPO5vAazlJBQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_co
Cf4rww0USO5LnxG9r_Ifzij09EHoVOR2VqRBDPh4ZKm2gNc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=1AOLw3Ir7lRxP5ZyqMFp3w&_nc_ss=7a22e&oh=00_Af-2wwxC_TCo4rFHWikAw9Zq3Fw6D8ZmcyfDRhO-54ACKQ&oe=6A265537", "width": 1440, "is_spatial_image": false}, {"estimated_scans_sizes": [], "height": 640, "scans_profile": null, "url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.82787-15/642807240_18127062055487646_5577670178759427721_n.jpg?stp=dst-jpg_e35_s640x640_sh2.08_tt6&_nc_cat=105&ig_cache_key=MjA3NTQ4MzIxNTk4NTk5MzE2NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=zmRaLltDmToQ7kNvwG6nnqu&_nc_oc=AdqZbLiovPodyMtusLAICf4rww0USO5LnxG9r_Ifzij09EHoVOR2VqRBDPh4ZKm2gNc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=1AOLw3Ir7lRxP5ZyqMFp3w&_nc_ss=7a22e&oh=00_Af-vYrZGfZhIybtCA9ubAdgQ2b5KuUhsbnS-7fJ6lihOrg&oe=6A265537", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1440, "usertags": {"in": []}, "featured_products": []}], "like_count": 211648, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18051260647093538", "bit_flags": 0, "created_at": 1561636905, "created_at_utc": 1561636905, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18051260647093538", "share_enabled": false, "content_type": "comment", "media_id": "2075483223267232545", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Amici visto che ne abbiamo parlato nelle storie ne approfitto per ribadire il concetto anche qui. Per riassumervi la premessa, una ragazza oggi in direct, scherzando, mi ha scritto che anche io come lei avevo dei segni sotto l’occhio che ironicamente si dice vengano a chi “ha pianto troppo”, implicitamente connotandole di una natura infausta; cosí le ha detto il chirugo e questo parere tecnico aggiunto al di lei parere personale, condizionato dalle foto piallate e ritoccate che tutti i giorni vede sui social, le hanno impiantato la convizione di doversi ritoccare in tutte le foto attendendo di sottoporsi ad una blefaroplastica. Ora, questo episodio mi ha fatto riflettere e preoccupare. Temo si sia perso completamente il contatto con la realtà e questo è principalmente dovuto al fotoritocco che col tempo ha a tal punto alzato l’asticella della “normalità”, da rendere inaccettabili cose che neanche dovrebbero notarsi. Le rughe che abbiamo sotto, sopra o intorno agli occhi sono rughe di espressione che riconsegnano il nostro viso ad una preziosa unicità, non sono solchi che la blefaroplastica deve piallare rendendoci uguali ai cloni che ormai padroneggiano il web. \nVolersi vedere più belle con un po’ di trucco, scegliere la foto in cui si è venute meglio, fasi una piega o un colore che ci valorizzano è più che giusto se ci fa sentire meglio, ma non vediamo mostri dove non ce ne sono e SOPRATTUTTO non viviamo nel costante paragone con ció che vediamo su internet, almeno fino a che non cesserà di esistere un divario tale tra foto e realtà, da farci sentire tutte cesse senza speranza. Mi piace pensare che le mie, di rughe, siano venute perchè nella vita ho riso tanto, e allora perchè dovrei piallarle? GUARDATELO TUTTI QUANTO SONO FELICE.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gEPMThN2TIT4kcRPj4UETM_A6HOFbgGi-2f75xwsC1hiKP1YZl0_G-sQad
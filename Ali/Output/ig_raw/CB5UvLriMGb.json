3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=XHXJ-AjaOd8Q7kNvwH01HKB&_nc_oc=AdrCUieSbnmh7kafRgP4DthbxRSbJ44WMs4EU_J_VYFa08rNCFrNYMJU5Ba5yCdM1KU&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=uQEL_Wr1Xriv0voGW4lh0g&_nc_ss=7a22e&oh=00_Af-05TYP4bhzsrNIaEifmuhwcmNkGUPA7LU4JgLMBtFeTw&oe=6A264F3D", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1800, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 110014, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17927563930392215", "bit_flags": 0, "created_at": 1593169646, "created_at_utc": 1593169646, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17927563930392215", "share_enabled": false, "content_type": "comment", "media_id": "2339992684682854811", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Questo è il periodo dei compiti delle vacanze e io me lo ricordo bene perchè li ho compilati tutti su quello sgabellino lí, che se lo apri diventa pure una scaletta, la mia scaletta, su cui nonna Etta mi faceva sedere appoggiata con i gomiti al tavolo della cucina. Una pagina al giorno, i giorni sfortunati con le consegne lunghe, due, quando proprio andava male, tre. \nLa nonna Etta ha insegnato per tutta la vita italiano ai bambini della scuola elementare e tutta la grammatica me l’ha spiegata lei a furia di correggermi le doppie con la sua matitona da un lato rossa, dall’altro blu, con cui quando facevo tutto bene mi scriveva brava! sull’angolo in basso del foglio, proprio cosí, col punto esclamativo, e io mi inorgoglivo tutta quanta. Da circa due mesi la cucina della nonna Etta è vuota, cosí mi sono portata a casa il mio sgabello suo, chissà che magari mi possa aiutare a lavorare meglio e se faccio tutto bene, senza segni rossi dico, alla fine lo penserà anche quest’anno che sono stata “brava!”.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gEBYuDgOrYv1IOIRaxcWP_5m2LzM9F3obT9XZpZATAujPzZxyK6WsF8t0nZHJzyTnY&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=uQEL_Wr1Xriv0voGW4lh0g&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af8TnpiUWttD7LP4vEIOIpkKLR3qJfX_ek9L_wPYpofPcA&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 780, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connec
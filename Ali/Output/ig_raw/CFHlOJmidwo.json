2.08_tt6&_nc_cat=109&ig_cache_key=MjM5ODA0OTAyNjcwMTkwOTAzMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuOTU5LnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=uT8N2Czf9DsQ7kNvwHcEwkm&_nc_oc=AdrutwxxtQrehJtIH0VnXgToJJ0Z-OX7IduTlTR9F544AfQImz1WoMd2yhQmUwRikpc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=6uUaYsGsrdhaHTQI1je9ow&_nc_ss=7a22e&oh=00_Af8CGzYmx91RuS-QIV0IHxHV-YcJiThaQIB4B54cgKJ4vg&oe=6A2644A6", "width": 640, "is_spatial_image": false}]}, "original_width": 959, "original_height": 1199, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 175457, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17916795754467356", "bit_flags": 0, "created_at": 1600090336, "created_at_utc": 1600090336, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17916795754467356", "share_enabled": false, "content_type": "comment", "media_id": "2398049026701909032", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Era il 1996 e i miei genitori non avevano acconsentito a comprarmi lo zaino di piccioli problemi di cuore, che era quello che volevo io, ma, applicando la saggezza e la lungimiranza degli adulti, me ne avevano comprato uno della Seven, tutto giallo. Inutile nascondere che attraversai un primo momento di infantile delusione, che cos’era sta Seven? Ma chi la voleva? E non era nemmeno rosa. Poi mamma mi spiegó che, proprio nella tasca più in alto, questo zaino aveva un buchino per farci passare le cuffiette del walkman, così avrei potuto sentirmi la musica mentre andavo a scuola, come facevano i grandi e questo ultimo dettaglio mi convinse circa la sua unicità. \nEro una bambina timida, faticavo a iniziare le conversazioni con i miei coetanei, sentivo la mancanza degli abbracci di papà e delle carezze di mamma, per questo l’idea di separarmi da loro mi gettava nella più inconsolabile delle disperazioni. \nEra il 1996, il mio primo giorno di scuola, ricordo che mi veniva da piangere e lì dentro non ci volevo entrare, peró poi non so cosa successe e quando tornai a casa, qualche ora dopo, pensai che dopo tutto non era affatto male questa cosa dei banchi, delle maestre e delle nuove amiche, soprattutto se poi potevo fare vedere loro quanto era comodo il mio zaino giallo della Seven, “che c’ha pure il buco per le cuffie, lo vedi? Io ci ascolto i backstreet boys”.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gE3_HU88l9W3izwfIZ-90hBBx1IQKfn92mkfBpvXWh1gsMrrCm8s3KoqlCvuIqOP8s&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=6uUaYsGsrdhaHTQI1je9ow&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_vJP4JensxrXcq_YcHXpUtSvyNfKCwK8l3vypMvcbKLg&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 943, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_pos
IwNDU3MTU4OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=ffUyei5PjZsQ7kNvwFOJiY0&_nc_oc=Adpq1kGrpCeFzfoHLt5enDXbWn9mfbCGYGV8zSw35OxYcaujmGWDJQls9UizhmzeP8M&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=OhEGxOWw2r6uhUBbN9AxLg&_nc_ss=7a22e&oh=00_Af9FPjBbk36qzmSZfDxHPkXyJ3r6O7PtW83PIeqNIOKqoQ&oe=6A264F74", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1800, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 241443, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18118403833181965", "bit_flags": 0, "created_at": 1601130400, "created_at_utc": 1601130400, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18118403833181965", "share_enabled": false, "content_type": "comment", "media_id": "2406775163204571588", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "In questi mesi ho scritto e riletto molto, ho capito che trovare le parole che descrivano bene quello che hai mente puó essere impresa ostica e spesso infruttuosa. Secondo me, una cosa difficile ma utile, per trovare le parole dico, è partire da momenti che ti ricordi più di altri. Ad esempio qui era il 2015, che mi pare una vita che non ho mai vissuto, ma invece l’ho vissuta eccome, e mi ricordo che io pensavo di stare benissimo, di esser felice, li credevo tutti matti quelli che dicevano il contrario. \nOggi invece, mentre mi riguardo, mi sembra che avevano ragione.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGXG44c1-zL22pQj_l4p3iQrf-tpHXfHmyuAEVEYXQLydVjGoosnPPuH42vEOScgQA&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=OhEGxOWw2r6uhUBbN9AxLg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-aZE25pw1cMGtXjGyAfiMOSdBrEjcjhLzZDxq7UeeisA&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "In these months I've been writing and re-reading a lot, I understood that finding words that describe well what you have in mind can be a wasteful and often fruitless undertaking. In my opinion, a difficult but useful thing, to find the words, is to start from moments that remind you more than others. For example here was 2015, which seems to me like a life I have never lived, but instead I lived it here I am, and I remember that I thought I was fine, that I was happy, I believed everyone was crazy who said the opposite.\nToday, however, when I look back, it seems that they were right."}, "comment_count": 2228, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_t
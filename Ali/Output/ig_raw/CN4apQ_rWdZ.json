agram.com&_nc_cat=104&_nc_oc=Q6cZ2gFJEAuwJCLtTeNe03vFJWPqB5ckvtlM_mRBVpiUFv4AWunecLGhCuw9C73gAPBzYwg&_nc_ohc=EIfp4Z1v8goQ7kNvwFbjjNS&_nc_gid=y1OqGFP8NHD5PtgEkF7yAA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9tD5Q96KkVLzkzgqRAi62bagYWnFB78oHUVPIfocY0zA&oe=6A264664&_nc_sid=fc8dfb"}}, {"position": [0.8138629198, 0.5327102542000001], "user": {"strong_id__": "5690376146", "pk": "5690376146", "pk_id": "5690376146", "id": "5690376146", "username": "lauraceccacciagency", "full_name": "Laura Ceccacci Literary Agency", "is_private": false, "is_verified": false, "profile_pic_id": "2968447566022330295_5690376146", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/315321227_938520563796877_5646076734682370787_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4zMjAuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=101&_nc_oc=Q6cZ2gFJEAuwJCLtTeNe03vFJWPqB5ckvtlM_mRBVpiUFv4AWunecLGhCuw9C73gAPBzYwg&_nc_ohc=tCBAOTPKyQEQ7kNvwFhr9t0&_nc_gid=y1OqGFP8NHD5PtgEkF7yAA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_on05NyKecl8JP4UJnzAi4n90a5k0svBtY92Nk0i5HmQ&oe=6A264599&_nc_sid=fc8dfb"}}]}, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 93317, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17887117640151197", "bit_flags": 0, "created_at": 1619021896, "created_at_utc": 1619021896, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17887117640151197", "share_enabled": false, "content_type": "comment", "media_id": "2555909973488789337", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Oggi “Per tutto il resto dei miei sbagli” esce in tutte le librerie. \nIl giorno prima di un esame, di un colloquio, di un lavoro importante, di un’occasione in cui sapevo di dover dimostrare qualcosa ho sempre dormito malissimo. Processare l’ansia e la preoccupazione percorrendo i corridoi di incubi atroci è stata e continua a essere una costante della mia vita. \nStanotte invece, fatta salva un’autonoma sveglia all’alba, ho dormito benissimo. \nNon posso esserne certa, ma sono convinta che questo nuovo modo di affrontare l’attesa sia dovuto all’affetto che ho ricevuto da parte vostra nei giorni che hanno preceduto l’uscita. Sono stata letteralmente sommersa dalle vostre parole gentili, da messaggi di scalpitante attesa, da un supporto virtuale potentissimo, ma soprattutto dalla vostra fiducia. Questo post è per dirvi GRAZIE. \nOvviamente ora moriró di pizzichi, come si dice a Perugia, aspettando di sapere cosa ne pensate, ma nel frattempo vi abbraccio con la stessa forza con cui lo avete fatto voi, prima di me. Buona lettura! #pertuttoilrestodeimieisbagli", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gFJEAuwJCLtTeNe03vFJWPqB5ckvtlM_mRBVpiUFv4AWunecLGhCuw9C73gAPBzYwg&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=y1OqGFP8NHD5PtgEkF7yAA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-69jl9lzQN7M_Z9uhmUfR607uZhfypoZtWoEW3VlFx8g&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 661, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950
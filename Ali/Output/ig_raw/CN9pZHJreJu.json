U1NzM4MjIwODk4ODc2NjgzMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=1JKjZ3mypvIQ7kNvwH-a-F1&_nc_oc=Adp2XTxtYnsUThgwMp43A5NpKiVygL8PNpOrt7AC-4i7Z2erpo_zYNBz9MMovNyegwk&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=TsuLfLVm1Hw4hM2IDZ9ldw&_nc_ss=7a22e&oh=00_Af8FgCLqbz3O_SYy7flHQF4QsHDM10GhpTwJtGyX6QR3Og&oe=6A2658EA", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1800, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 61345, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17977787878370142", "bit_flags": 0, "created_at": 1619083739, "created_at_utc": 1619083739, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17977787878370142", "share_enabled": false, "content_type": "comment", "media_id": "2557382208988766830", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Scrivo mentre percorro i chilometri di questa giornata, che si proietta ancora lunga all’orizzonte. \nHo aspettato questo tour nelle librerie per anni, l’ho sognato tante volte, ancora prima di finire il libro, ho immaginato gli abbracci sinceri che ci saremmo scambiati e i sorrisi timidi di quando si vuole solo dire grazie, ma non si trovano le parole. Non vi nego che sapere di non trovarvi lí, per incontrarci finalmente, mi provoca un’ egoistica malinconia. Sarebbe stato bellissimo, secondo me. Nonostante questo il mio cuore esplode di gioia, sto leggendo i messaggi di chi ha già finito il libro, ascolto i vostri pensieri, osservo quali periodi avete scelto di sottolineare, mi emoziono ad ascoltare le vostre impressioni. Forse non è esattamente tutto come lo avevo immaginato negli anni, certo, perchè mancate voi, eppure vi sento cosí vicini. Mi sembrano, questi, giorni meravigliosi e sconvolgenti.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gEeq-F9m8hTOe3M3-z3LhqPSyvbp8jp0-xIdCHZzj8hD9nGTYcIH56fTtfeJqsLvJ8&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=TsuLfLVm1Hw4hM2IDZ9ldw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-fXGhZvdGXu1yXaostYjCDe3ZoJTSwdHxDjcKLatLV0Q&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 191, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc
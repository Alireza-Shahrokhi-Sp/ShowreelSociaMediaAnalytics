nfos": null, "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 66639, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17890679278993912", "bit_flags": 0, "created_at": 1618230743, "created_at_utc": 1618230743, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17890679278993912", "share_enabled": false, "content_type": "comment", "media_id": "2550226625860021403", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Allora amici mai come in questi ultimi mesi ho ricevuto domande su quale mascara stessi usando e mai come in questi ultimi mesi ho distribuito risposte vaghe e sfuggenti perchè era tutto in fase di creazione e test. \nCon i miei storici partner di @we.makeup abbiamo formulato un nuovo mascara, VERY, che dopo aver testato in lungo e in largo posso confermare essere una VERa bomba. \nIl piano era quello di aspettare ancora un po’ di tempo ma abbiamo pensato di partire con anticipo, per organizzarci meglio, con chi fosse già convito di volerlo provare.  Cosí vi annuncio che sul sito di Wemakeup è ufficialmente aperto il preorder per il nuovo mascara VERY, di cui ancora posso dirvi poco, ma chi lo volessee ordinare per evitare imbottigliamenti il giorno del lancio può già farlo! \nVi ho registrato questo video senza eyeliner nè nulla per farvi vedere l’applicazione “in purezza”!\nPotete intravederne lo scovolino ma sul sito si vede meglio. \nOvviamente a tempo debito vi dirò TUTTO, dal pack alla formulazione etc, per ora volevo solo aprire le danze per far funzionare la macchina degli ordini e spedizioni al meglio♥️\n#Very #camiescistomascara", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGdeNGJoWC1zbfwbUPb1a3yW62dDugpt2CGzh6XUPT0mqUCov6flU9usa6psze2dBo&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=ITk2IC12eSJ1ak_5i9AObA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9fsp_-1tPsXZZpoPgYtZNpHcg2U4igF80A-JRfYkJvDw&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 878, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "play_count": 2645190, "ig_play_count": 2645190, "shop_routing_user_id": null, "featured_products": [], "video_duration": 30.020000457763672, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT0H0M30.020S\" maxSegmentDuration=\"PT0H0M1.997S\" FBManifestTimestamp=\"1780504433\" FBManifestIdentifier=\"FuLdgqINGBBpZ19kYXNoX2Jhc2VsaW5lGTbU/+216Me
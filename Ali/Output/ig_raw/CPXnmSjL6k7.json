.08_tt6&_nc_cat=105&ig_cache_key=MjU4MjcwNzA2NjM5MTk5NjczMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=0UVJ_xIq6DMQ7kNvwF7i42N&_nc_oc=AdpoluqX6Gic1aKKMMbuMdQHaUmubyNGcSPdBiRabpt0-TQBfCv7lK9_YuAaaHhGw8E&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=dkewXKpoUXjeIg-SiKpbuA&_nc_ss=7a22e&oh=00_Af-mk5O2sFrLV2T0RXPn7VtCNBzmuQ1ptuT5z1sJH9G7VA&oe=6A266CF5", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1545, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 186403, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17874148589496155", "bit_flags": 0, "created_at": 1622102696, "created_at_utc": 1622102696, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17874148589496155", "share_enabled": false, "content_type": "comment", "media_id": "2582707066391996731", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "So che per molti questa foto non significherà nulla, ma per chi c’è stato negli ultimi anni rappresenta un buon auspicio. \nHo questo cactus da molto tempo, da quando vivevo da sola a Milano e lo tenevo sul terrazzino di 20 centimentri che usavo per la spazzatura. L’esposizione era pessima e ogni tanto, quando fuori diluviava, mi dimenticavo di ripararlo dalla pioggia. \nPer quattro anni, nonostante le cure precarie che gli riservavo, ha fatto un fiorellino. \nQuesto tipo di cactus regala fiori bellissimi, ma si schiudono di notte e durano al massimo un giorno soltanto. \nPer varie vicissitudini io, il suo fiorellino, non sono mai riuscita a vederlo sbocciare, lo trovavo sempre appassito, il giorno dopo, floscio testimone del mio pessimo tempismo. Quest’anno, per una strana legge del contrappasso, la sua bellezza me la sono goduta tutta quanta. \nVi presento Pasqualino: per altre 12 ore sarà la mascotte di questo profilo, grazie per averne seguito amorevolmente la nascita. ❤️", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gFBifn-_fzIgr9b3_RPF0FoHSCrxULNpfbvRSQ4Mu8cVZjc9nooDu5FN1L6srYXdq0&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=dkewXKpoUXjeIg-SiKpbuA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9Xst6nwMfrfgHh_YbQdTJyZ1RiFqPUw2y6lSZF4ytf-g&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "I know that this picture will mean nothing to many, but for those who have been there in recent years it represents a good omen.\nI’ve had this cactus for a long time, since I lived alone in Milan and I kept it on the 20 centimeter terrace that I used for garbage. The exposure was awful and every once in a while when it rained outside, I forgot to rain it.\nFor four years, despite the precarious care I reserved for him, he made a little flower.\nThis type of cactus gives beautiful flowers, but they hatch at night and last only a day at most.\nDue to various vicissitudes I, its little flower, never managed to see it bloom, I always found it withered, the next day, a flush witness to my bad timing. This year, thanks to a strange counter-countermeasure law, I enjoyed its beauty as much as possible.\nMeet Pasqualino: for another 12 hours he will be the mascot of this profile, thank you for lovingly following his birth. ❤️"}, "comment_count": 1361, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_tab": null, "fan_consideration_page_revamp_eligiblity": null}, "friendship_status": {"following": true, "is_bestie": false, "is_feed_favorite": false, "is_private": false, "is_restricted": false, "followed_by": false, "is_muting_reel": false}, "hd_profile_pic_url_info": {"height": 719, "url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gFBifn-_fzIgr9b3_RPF0FoHSCrxULNpfbvRSQ4Mu8cVZjc9nooDu5FN1L6srYXdq0&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=dkewXKpoUXjeIg-SiKpbuA&edm=ALQROFkBAAAA&ccb=7-5&
_nc_cat=103&ig_cache_key=MjYwOTYxODQ3NDkwNzc2OTc0MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=QWF0wIQLhgcQ7kNvwFQeYeG&_nc_oc=AdpgljtuqThGH3v5j9wwtHcLtrMeBBt-LIKWFvyUngR11JxMM09trSp16-tT4zJ0jzg&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=ipcIIeG8iyTAiwLdspUkmQ&_nc_ss=7a22e&oh=00_Af95d24ESZi3X5SeCygfi1xgm0gUH1ngmPFysjaDfL8uUg&oe=6A266096", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1800, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 3, "has_liked": false, "top_likers": ["nicole_lalli"], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17908214149866101", "bit_flags": 0, "created_at": 1625310918, "created_at_utc": 1625310918, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17908214149866101", "share_enabled": false, "content_type": "comment", "media_id": "2609618474907769741", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Ho finito di leggere questo libro e pensandoci non credo riusciró a spiegarvi bene cosa ne penso. Mi verrebbe da dire che è un romanzo ma anche un insieme di poesie, oppure che è un album fotografico con le parole che descrivono i ricordi meglio di quanto sappiano fare le immagini. Ci sono cose che devi rileggere perchè a un primo sguardo ti sembra di non averle capite, e infatti poi non le avevi capite. Moltissime pagine poi, sono lentissime, che sembra quasi non finiscano più. Ci sono passaggi cosí belli che ti chiedi come li abbia partoriti, altri che vorresti quasi saltari per la fatica di decifrare cosa c’entrino. Come si riassume tutta questa roba qui? È come un museo d’arte contemporanea: ci sono opere che capisci, opere che non capisci ma di cui in qualche modo comprendi la bellezza, percorsi tortuosi senza una vera ragione, sculture che ti fermeresti a guardare per ore. All’uscita non sai bene cosa hai visto, ma non vedi l’ora di raccontarlo. \nSí, per me questo libro è un museo d’arte contemporanea.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHn8YHXz7LgYtB4mUKApVz4lXwrjYlN4HTvmqaB6Gei9zjTMj5bLeEyuYAOeWsItyk&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=ipcIIeG8iyTAiwLdspUkmQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af85fIMcnlfprsTBvJcJQFhKWYojbteCn54PC1YFSfSdWw&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 96, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fa
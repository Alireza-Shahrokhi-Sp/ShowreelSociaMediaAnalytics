acere. \nIl disegno della libreria invece è stato realizzato dai quei compagni del grifo mitici che sono i @23bassi. Nelle storie vi faccio vedere tutto meglio, compreso il semaforo che ha comprato romi.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gE9ZD_ATcdVNthr5c2nepqcgPbIY0_0ox-hNdDX6mLoLvZQsKWZdFiufxRlANixy_o&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=ir9pbQN-kp4BUnqDGH_MEA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_JMm5jHhTkLCPeLJh_-P0PRmUh9D2Uo9XNXj_wngdTnQ&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 189, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "play_count": 1318453, "ig_play_count": 1318453, "shop_routing_user_id": null, "featured_products": [], "video_duration": 26.211999893188477, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT0H0M26.212S\" maxSegmentDuration=\"PT0H0M1.997S\" FBManifestTimestamp=\"1780504571\" FBManifestIdentifier=\"FvbfgqINGBBpZ19kYXNoX2Jhc2VsaW5lGTbwu+qb3rCwA9a7ubu78t0Fjv31sueGzggiGBNkYXNoX2Jhc2VsaW5lX2F1ZGlvIiwZGAtleHRyYV9saWdodAAWqBwUABIUAgA=\"><Period id=\"0\" duration=\"PT0H0M26.212S\"><Adapta
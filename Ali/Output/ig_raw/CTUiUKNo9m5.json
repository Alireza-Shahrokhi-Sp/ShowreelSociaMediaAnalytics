 come, riesce a sfiorare con delicatezza la ferocia più cupa, racconta senza sentenziare, scava senza spiare, restituisce domande quando eri certo di avere già in tasca le risposte. È un solido scomodo e pesante, questa storia, e a trasportarne il peso ci pensa l’abile penna di Nicola, capace di traghettarci, a poco a poco, verso infere sponde.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGh4lv50_ZLxDZOIGrgEJpbJsIFrFAOZlegwWu-Q7btV6icinAJS79FPLAs7SQwkgc&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=BgDYZU0pslpo0WeUGVqVnQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af__8gw1CvWtr3iXcgSkZK7KI19OMl9EhXg8ovIORjylmQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 138, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "use
6179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHVus5sKt0G-7T797aLvWIS17rC-3zk36L2hobR_dQSLt6GVupIM01-Bi_F4qnBD6o&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=jAy5WDymLVZLuEwWbAs95g&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-u76LT1jGeBhimmh3Ivg7Bpxf2hkIc_PxEfa6PolWiYg&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "It’s raining today so I’ll post a picture from yesterday when we took a beautiful vintage train that took us from downtown Palma to Soller. Looking out the window I imagined what it must be like to travel on those wagons in Spain in the late eighties, to arrive at your destination dead tired after a long journey, to go to the bathroom and not even have the pleasure of being able to bidet! Fortunately now things have changed.. ah don't expect"}, "comment_count": 118, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id":
lse, "top_likers": ["_mari.ghi_"], "facepile_top_likers": [{"strong_id__": "5613507901", "pk": "5613507901", "pk_id": "5613507901", "id": "5613507901", "username": "_mari.ghi_", "full_name": "Maria Ghilotti", "is_private": false, "is_verified": false, "profile_pic_id": "3342387025531288793_5613507901", "profile_pic_url": "https://scontent-mxp1-1.cdninstagram.com/v/t51.2885-19/436036344_1550923695467799_5589390543750382225_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gGMEnTJFhwFrF3EDzoj_hGZUu_J_2VrPZEyQhBL3o5nKh1VGkJGoHpde0JSKwM-Jao&_nc_ohc=soDmXoRkJ-sQ7kNvwFOLMcN&_nc_gid=fzwdPaUkIlZHQjSXhYQNhA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_CKNx5bqYILtnViribWyqZ-8Cfts0CFB1U4YRWldFIXg&oe=6A26741B&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17925270586853939", "bit_flags": 0, "created_at": 1637862651, "created_at_utc": 1637862651, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17925270586853939", "share_enabled": false, "content_type": "comment", "media_id": "2714762822442582235", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Questa è la storia di un lampadario piuttosto sfortunato, che ho comprato anni fa e iniziato a odiare dal primo momento in cui l’ho acceso. Uno dei tanti acquisti sbagliati che si fanno quando si compra casa. \nIeri dopo 3 anni ho chiamato l’elettricista e l’ho fatto cambiare, ma quando l’ho visto staccato dal soffitto, ammetto che ho provato un certo dispiacere: dopotutto nelle tenebre di cui lui era sovrano ci ho vissuto tre anni e come per tutte le cose alla fine ti ci affezioni. Così ho pensato a come appuntarlo nella classifica dei lampadari che hanno cambiato la storia e mi sono detta: lo metto all’asta con dedica e il ricavato si devolve in beneficenza. E così ho fatto. È nato tutto come uno scherzo, ma l’asta si è chiusa a 451€, con un’ enorme partecipazione. Questi due dati sono indicativi della meravigliosa community che abbiamo costruito in questi anni. \nEleonora, che si è aggiudicata il lampadario, ha deciso di devolvere la cifra a ACTO Onlus, associazione contro il tumore ovarico. Claudia, invece, avrebbe scelto Emma Onlus (iban nelle storie o comunque andate direttamente sul loro sito dove troverete link diretto alla donazione) che si occupa di contrastare la violenza sulle donne attraverso l’importanza dei centri antiviolenza, perfetto per celebrare la giornata di oggi. Siccome ogni finalista aveva una bella destinazione per la sua somma, ve le ho condivise tutte in modo che, anche se non vi siete aggiudicat LO SPLENDIDO lampadario, possiate comunque, se vi fa piacere, dare un aiuto. ❤️ grazie a tutt", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGMEnTJFhwFrF3EDzoj_hGZUu_J_2VrPZEyQhBL3o5nKh1VGkJGoHpde0JSKwM-Jao&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=fzwdPaUkIlZHQjSXhYQNhA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af826gI9Nx34ebJItDf8F2nwYj6rDqZeZZx5YRF0ITMa9g&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 281, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "t
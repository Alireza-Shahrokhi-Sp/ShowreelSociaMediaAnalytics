RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmV4cGVyaW1lbnRhbCJ9&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gE1ZArOyBbfbijgFPj8XJT8fAG98-zc6b991DK9ZLKQod9bXN9zQFbRvrNf9Tdajpg&_nc_ohc=8rdM3tINRVgQ7kNvwHIJdQr&_nc_gid=rRJRRHpMRt1-dLDldRVeXw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-xF5Qc6XW_PYXiiRXzgrpwnT77wbOC6KnwPjc6xgXzuw&oe=6A26507E&_nc_sid=fc8dfb"}}]}, "fb_user_tags": {"in": []}, "media_overlay_info": null, "media_notes": {"items": []}, "social_context": [], "creative_config": null, "floating_context_items": [], "is_reuse_allowed": false, "igbio_product": null, "like_count": 68523, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17921175503301286", "bit_flags": 0, "created_at": 1644078862, "created_at_utc": 1644078862, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17921175503301286", "share_enabled": false, "content_type": "comment", "media_id": "2767036222582566767", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "L’ultimo tramonto di questa settimana sanremese ce lo siamo godute insieme, sugli scogli del porto battuti dal suono del mare. \nÈ stato tutto bello e intenso. \nIn questa città ci siamo conosciute nel lontano 2017 e questi giorni insieme sono stati la perfetta spirale d’affetto che è ripassata dal suo punto di partenza. \nDobbiamo ringraziare di cuore @spotifyitaly per averci scelto come capitane del podcast ufficiale di quest’avventura sul mare, voi tutti per essere stati incredibili compagni di viaggio, tutta @showreel_agency e @lucaleoni che ci hanno tracciato la rotta, @giovanni_desanctis che si è visto sei lunghe albe montando tutte le puntate e ultimo ma non meno importante il nostro mitico @grossi__m, arbitro, autore, amico. Che vinca il migliore artista in gara, noi la nostra vittoria ce la siamo portata a casa oggi, alle 16,40, guardando un orizzonte stupendo che ci ha fatto riflettere su quanto a
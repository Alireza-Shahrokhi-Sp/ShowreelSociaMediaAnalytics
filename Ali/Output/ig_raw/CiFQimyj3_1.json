kers": ["rss.mtt"], "facepile_top_likers": [{"strong_id__": "713329593", "pk": "713329593", "pk_id": "713329593", "id": "713329593", "username": "rss.mtt", "full_name": "Mattia Rossi 🌊", "is_private": false, "is_verified": false, "profile_pic_id": "3669299857290781556_713329593", "profile_pic_url": "https://scontent-mxp1-1.cdninstagram.com/v/t51.82787-19/514862270_18516205495049594_8556620336802317856_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=102&_nc_oc=Q6cZ2gH1zfeA_WacV8tywxyx_bMcLl13H96yUSUm-BSA8rYWJ39sxsYL6UkJPDXHJqUFgI8&_nc_ohc=ggic0EBBPvcQ7kNvwG-aPPq&_nc_gid=g-t6qJ0ddgNvKxI7W0HUfA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_ZfDBGwblEkXQIE4eihA0SDeu6x457MXAMYbi8orol7A&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18144163486263991", "bit_flags": 0, "created_at": 1662289672, "created_at_utc": 1662289672, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18144163486263991", "share_enabled": false, "content_type": "comment", "media_id": "2919812680276475893", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Concedetemi ancora qualche post su Venezia perchè le prime volte sono cosí cariche di nuovi colori che ci vogliono tante tele per contenerli tutti. Un ringraziamento speciale va a @daizy_shely che quando le ho chiesto se avesse voluto vestirmi per Venezia, ha accolto la notizia con enorme entusiasmo proponendomi di disegnare e realizzare il mio primo vestito custom. \nSiamo partite da un suo disegno (ultima foto) per poi arrivare alla forma-colore-ricamo che rispecchiava perfettamente i miei desideri. È stato un onore per me indossare il tuo abito❤️\nTutta la mia gratitudine e affetto, poi, ai miei amici, una squadra perfetta che ha reso questa esperienza impeccabile: @helio83 , che ormai conoscete, @marademarcomua che mi ha truccato da vera principessa, @annapastore e @sara_dozio che hanno curato tutto lo styling prima e durante il red carpet e le mani miracolose di @martinamariottiph che hanno immortalato i momenti indimenticabili di ieri. \nGrazie ai miei genitori che hanno fatto di tutto per esserci e ci sono riusciti. \nE Grazie a voi, sempre e soprattutto, che siete una famiglia virtuale incredibile.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gH1zfeA_WacV8tywxyx_bMcLl13H96yUSUm-BSA8rYWJ39sxsYL6UkJPDXHJqUFgI8&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=g-t6qJ0ddgNvKxI7W0HUfA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9GI_l1DSel6orlQP4FFW5NEx5nvhJplXXnrblROHh_aQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 1229, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username"
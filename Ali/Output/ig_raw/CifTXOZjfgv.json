8_tt6&_nc_cat=100&ig_cache_key=MjkyNzE0MzQzNTI0NzY3MTIzMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTQ0MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=M023T3Gfsg8Q7kNvwHMcgeR&_nc_oc=AdrBaCndpuDKb5vXVNVfK2tDfQ6rvRsnq5m2orWqqZ1H8Lt21S-WRurZ9lOxVMaI4Cc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=ycOECGGdkAQXK2g5qacOwQ&_nc_ss=7a22e&oh=00_Af-kXZyIxGBQRBhSIOny1AAW3yjfND54FoJq4QCdGGHizA&oe=6A265A2C", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1029, "featured_products": []}], "like_count": 80433, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18244094350188933", "bit_flags": 0, "created_at": 1663163061, "created_at_utc": 1663163061, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18244094350188933", "share_enabled": false, "content_type": "comment", "media_id": "2927143441706907695", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Sono la seconda di tre Fratelli: Io, Federico e Riccardo. I nostri genitori ci hanno educato alla fantasia: non abbiamo mai avuto molti giochi materiali, fatta eccezione per la spada di Hercules di Federico che era stato un sogno realizzato, difeso come fosse il santo Graal. \nMamma e papà volevano che ci sforzassimo a inventarci giochi nuovi, recitare, travestirci e immaginare scenari fantastici che riempissero i pomeriggi passati ad aspettare il loro ritorno dal turno in ospedale. \nAbbiamo diretto numerose recite, costruito reami impalpabili e ogni tanto visitato pianeti lontanissimi. Lo facevamo con la nostra astronave che avevamo costruito sotto l’ultima mensola del grande mobile che avevamo in cameretta. Come piccoli idraulici in erba ci sdraiavamo per terra, infilavamo le teste sotto al mobile, lo sguardo fisso sul dorso della mensola, pronti ad attivare i propulsori galattici della nostra immaginazione.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gH5iFBOBil3577kweLqNL-cX43sXpJLKj9pINoquYG47JicUwNOQNeUbBB5MS371qA&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=ycOECGGdkAQXK2g5qacOwQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-QvWMzW4FCUxjICW7ey9oXpr7knGhKhm60GAwOzhyl6w&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 423, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is
comment": false, "pk": "17964075664943090", "share_enabled": false, "content_type": "comment", "media_id": "2948919881771034567", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Marocco giorno 1, mattina. \nSiamo partiti da Marrakech intorno alle 9 am per iniziare la tratta che in un paio di giorni ci condurrà nel deserto, dove dormiremo sulle dune dell’Erg Chebbi. Abbiamo attraversato un sacco di villaggi e città tra le Atlas mountais per poi raggiungere Ait-Ben-Haddou, città fortificata dove hanno girato molte scene di film e serie tv famosi, tra cui il Gladiatore e Game of Thrones. Sebbene sia una tappa abbastanza turistica è decisamente suggestiva e affascinante, vale la pena dedicarci una tappa! Ora dritti verso le gole del Dades! \n\n#morocco #marocco #aitbenhaddou", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGDx-LQ0JwyIvciDy9rGPl1mMIkvROjxr7rr5Aa3RKot3-lGZFvOGog-KVxKJmXK6U&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=2WlMunZ70_bxdlYtIe127Q&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_FlDRnJPHOSybtJuJgaWMPt29zLTYIjyRwPpXt8cWVSA&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 199, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false
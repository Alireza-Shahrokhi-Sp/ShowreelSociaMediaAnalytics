pam": false, "is_ranked_comment": false, "pk": "17944540304471647", "share_enabled": false, "content_type": "comment", "media_id": "2950261076753543211", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Marocco giorno 2: deserto del Sahara. \nNè io nè Romi avevamo mai visto le dune, è stato incredibile. \nLa sabbia è tiepida e soffice, il cielo -senza inquinamento luminoso- è un tappeto di diamanti, il silenzio rotto solo dal suono del vento. Abbiamo dormito con le finestre spalancate. Romi avrevve voluto spalancare anche la porta, io avevo paura entrassero i serpenti e ho preferito chiuderla. Mi hanno poi spiegato che i serpenti o le volpi ben si guardano dall’entrare nelle tende. \nGli animali autoctoni vivono indisturbati nel cuore del deserto e di venire fra gli umani non ne hanno la minima intenzione. \nSono molto d’accordo con loro.\n\n#sahara #saharadesertmorocco #marocco #maroccotravel #morocco", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuZXhwZXJpbWVudGFsIn0&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHp3oFpVRV7ENQyIhYG08YOmc1OxK8xle71yhUOMfoRcKyMbQd1jW87AYTIYc-HIoM&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=14aARGiVT7x7kQsaxg59vQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-C3XCqtLQSDTSPvTO_zw8I9jrG3oKkk-ODQYEZ41CBYg&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 222, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], 
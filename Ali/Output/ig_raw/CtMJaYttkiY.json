1vQDFwg2OVUEb8m5_0M2IxiS1mlSV71QZpON6zeuNKS53By38jqgkPI8&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=A8Hxvuyg5bCkusSW95OFOA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-UXqf0hDHbevBODVsSXcvNTS8pwJN_JbGdZXRA1geM1g&oe=6A2632AC&_nc_sid=fc8dfb"}, "audio_filter_infos": null, "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 69689, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17856237725971325", "bit_flags": 0, "created_at": 1686142994, "created_at_utc": 1686142994, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17856237725971325", "share_enabled": false, "content_type": "comment", "media_id": "3119910037522630808", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Io alla morte ci penso spesso. \nMa non in modo triste, ci rifletto solo. \nQuella degli altri mi devasta, la mia non lo so. \nPensa se adesso morissi, quante cose mi sono persa, dico. \nDi solito è notte ma anche di giorno succede, quando sono in macchina succede spesso. Ma analizzando bene il tutto, la morte è il flagello di chi resta, non di chi scompare. Chi scompare non se ne accorge, che è scomparso dico. Quindi perchè dovrei temere qualcosa di cui non mi accorgeró? È come se io avessi paura, un giorno, di svegliarmi e scoprire che sono diventata un cerbiatto, un topo o un colibrí. Non puó succedere, è una condizione cosciente che non sperimenteró mai. \nHo paura di non avere più tempo con le persone che amo, rispondo, di non averne goduto abbastanza, di non aver scalato un numero ragionevole di montagne, nuotato in sufficienti mari. Quindi ho paura di quello che proveró prima, di quello di cui credo di aver paura. \nNon è la morte, quindi, ma l’impossibilità di continuare a riempirmi di persone e immagini e suoni e odori e percezioni. È la fame, che temo. \nSe allora potessi augurarmi qualcosa, vorrei ad un certo punto essere sazia, cosí da non avere più paura.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuZXhwZXJpbWVudGFsIn0&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGc0roxKp11vQDFwg2OVUEb8m5_0M2IxiS1mlSV71QZpON6zeuNKS53By38jqgkPI8&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=A8Hxvuyg5bCkusSW95OFOA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-UXqf0hDHbevBODVsSXcvNTS8pwJN_JbGdZXRA1geM1g&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 526, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "play_count": 980752, "ig_play_count": 980752, "shop_routing_user_id": null, "featured_products": [], "video_duration": 21.83300018310547, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" minBufferTime=\"PT1.500S\" type=\"static\" mediaPresentationDuration=\"PT0H0M21.834S\" maxSegmentDuration=\"PT0H0M6.833S\" profiles=\"
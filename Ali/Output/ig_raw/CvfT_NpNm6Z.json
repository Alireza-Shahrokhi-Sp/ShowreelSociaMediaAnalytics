": 15, "total_thumbnail_num_per_sprite": 105, "video_length": 24.381}}}, "original_width": 720, "original_height": 900, "featured_products": []}], "like_count": 131993, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17883285530908978", "bit_flags": 0, "created_at": 1691080328, "created_at_utc": 1691080328, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17883285530908978", "share_enabled": false, "content_type": "comment", "media_id": "3161333370298199705", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Uganda day1, giornata indimenticabile. \nAbbiamo visto il rinoceronte bianco da vicino al Ziwa sanctuary, dove stanno cercando di reintrodurre il rinoceronte bianco in natura nonostante sia stato dichiarato estinto alla fine degli anni 80. Max il ranger ci ha detto: qualsiasi cosa accada, se il rinoceronte dovesse puntarvi, l’importante è che rimaniate calmi senza correre. Certo Max, tutto chiaro. Stacco. Il Rhino ci ha semplicemente rivolto lo sguardo, abbiamo rannato in tre due uno. Seguiteci per altre ricette.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gH0b9oBBpPq7qd1fHjr4LXhe1GB6bMSWkoKCHUKO_B9DNxyvvjI_u6dTpcA8de5X2c&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=RcAozdhU7ECd9UyWpCZfkQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_qJV2lXsTFIAGssWUFO6cNMDOfcF8-jFoNvEXNuxQroA&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Uganda day1, unforgettable day.\nWe've seen the white rhino up close at Ziwa sanctuary, where they're trying to reintroduce the white rhino to the wild despite being declared extinct in the late 1980s. Max the ranger told us: whatever happens, if the rhino should target you, the important thing is that you stay calm without running. Of course Max, it's clear. Stack. The Rhino just stared at us, we froze in three two one. Follow us for more recipes."}, "comment_count": 137, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_tab": null, "fan_consideration_page_revamp_eligiblity": null}, "friendship_status": {"following": true, "is_bestie": false, "is_feed_favorite": false, "is_private": false, "is_restricted": false, "followed_by": false, "is_muting_reel": false}, "hd_profile_p
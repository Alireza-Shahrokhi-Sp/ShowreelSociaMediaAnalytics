nByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gF7tWr20zAWWAxbAfeVIsLqyUsQfmZBHdwKzyjTZ_-tf9wwt_E6ceM5q6BEKpCtKLw&_nc_ohc=soDmXoRkJ-sQ7kNvwFOLMcN&_nc_gid=x3VI5vfoU32FafCfyA9Yfg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9fgbV7vZkR7E9WvcAeB6s1jZ1Darnjm7zaRt1_C_aWkQ&oe=6A26741B&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18007116413005080", "bit_flags": 0, "created_at": 1696939507, "created_at_utc": 1696939507, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18007116413005080", "share_enabled": false, "content_type": "comment", "media_id": "3210483986471417875", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Ebbene sono ufficialmente aperte le vendite biglietti delle nuove date del Saggio di Fine anno. \nLasciatemi condividere con voi qualche foto che tuttavia riuscirà a restituire solo una minima parte della gioia, della tensione, della commozione e dell’amore che hanno colorato queste prime tre serate di debutto. \nGrazie a @guglielmoscilla , a cui dedicheró un post a parte, e che è stato la cura per ogni mia paura. \nGrazie a @frankmatano per la sua gentilezza e professionalità, ma soprattutto avere la risata più contagiosa dell’emisfero boreale. \nGrazie a @claudiodibiagio , per dire sempre sí a ogni cosa che ti propongo, perchè sei dolcemente matto in culo. \nGrazie a @piuttosto_che per i suoi stacchetti incredibili, il suo accento trasteverino e la sua simpatia. \n Grazie a @giorgio_camandona perchè il mondo della danza sa, e a @gianlucacornacchia_  e @_valeangeli_ per averlo dimostrato. \nA questi amici dico grazie di cuore per essere stati al mio fianco in queste prime tre date. \nChi invece sarà con me per tutto il tour sono @le_endrigoband: musicisti, intrattenitori, giocolieri mentalisti amici e molto altro. \n\nVi presenteró piano piano anche tutte le altre meravigliose persone che compongono questa grande squadra con cui ci vedremo nel 2024, ma per ora godiamoci questi sorrisi❤️", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gF7tWr20zAWWAxbAfeVIsLqyUsQfmZBHdwKzyjTZ_-tf9wwt_E6ceM5q6BEKpCtKLw&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=x3VI5vfoU32FafCfyA9Yfg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_CqzQmqrIQy3hnACyJwEsau50SEwiGkIAQdxFBHNnmjw&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 202, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": nu
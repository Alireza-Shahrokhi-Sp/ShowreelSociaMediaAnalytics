c_oc=Q6cZ2gF9TY6PfN1y7SEEnIRTnV0ngVGzVbah6QPJ7-_b49dJJWV_nSux4cvlGqKxEvD70xo&_nc_ohc=ggic0EBBPvcQ7kNvwG-aPPq&_nc_gid=5lYi91XeZKZyUK-erSFHfQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9sYsTpbVQosGdj2b_eO3k2hU4i7Up0MruB_bKDX1i7CQ&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17996192798331375", "bit_flags": 0, "created_at": 1697095172, "created_at_utc": 1697095172, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17996192798331375", "share_enabled": false, "content_type": "comment", "media_id": "3211788909759262728", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Lasciatemi fare un ultimo post per ringraziare non solo chi avete visto sul palco, ma tutte le persone incredibili che ci hanno lavorato e ci lavoreranno dietro. \nPartirei da chi ha scritto con me questo spettacolo: due autori, fratelli, cabarettisti, ballerini che in realtà nascono dal teatro: @volevosolocondurretrl e @christiantheseeker98. Grazie per essere stati imbecilli qb, vi voglio molto bene. \nGrazie a tutta la squadra di produzione di @vivoconcerti e ai tecnici che hanno lavorato allo spettacolo, capitanati dal solo e unico @gio.nesci: sapere che sarete con me per tutto il tour mi regala la stessa sensazione di quando togli gli scarponi dopo una giornata di sci, mi sembra di volare. \nDue persone poi sono state al mio fianco da sempre e non mi hanno fatta ricoverare quando una mattina mi sono presentata in ufficio dicendo “vorrei fare uno spettacolo a teatro”. Una è @beegatti, l’executive producer, che è la persona più affidabile che io conosca e che per mesi e mesi mi ha letto la mente facendo trovare già pronte cose che avevo solo pensato.\nLa seconda la conoscete bene e si chiama @helio83.\nPotrei dirvi che è stato il regista dello spettacolo ma non sarebbe sufficiente. \nHelio è stato tutto quello che serviva essere: un amico, un manager, uno psicologo, un veggente, un barman e il C.e.o della pazienza. \nPotrei fare a meno di tante cose nella mia vita, ma certamente non di helio di nardo. \nE questo è tutto, per ora❤️", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gF9TY6PfN1y7SEEnIRTnV0ngVGzVbah6QPJ7-_b49dJJWV_nSux4cvlGqKxEvD70xo&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=5lYi91XeZKZyUK-erSFHfQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9gb0GzBpNC13u1M282f8juBpaiJHvveVaIRjotX0gvlA&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0}, "comment_count": 27, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscrib
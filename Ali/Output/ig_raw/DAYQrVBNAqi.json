&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=2pptiEQ48nSiC4d9y4DN5Q&_nc_ss=7a22e&oh=00_Af-ew5G-w9ZAYZZH0eEeldHIatSX0yjrsBCO2F3HpELMKA&oe=6A267CAB", "width": 1440, "is_spatial_image": false}, {"estimated_scans_sizes": [], "height": 640, "scans_profile": null, "url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.82787-15/655874172_18107315164867673_500051999237303664_n.jpg?stp=dst-jpegr_e35_s640x640_sh2.08_tt6&_nc_cat=100&ig_cache_key=MzQ2NTU5MzI0NDgzMjA5MzIwMA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTQ0MC5oZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=gR7NRdhVaukQ7kNvwGi5XKE&_nc_oc=Ado8ikP3mR4V10oaqLZuXBqteFSjPYsiwU06-s1NBjCTTyO1AKm8RssimtvcHIOi5zc&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&se=-1&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_gid=2pptiEQ48nSiC4d9y4DN5Q&_nc_ss=7a22e&oh=00_Af-dxgJ9b7BtGzBbjyVY3xsN40QzvtKupPnXqDY1OdLUIg&oe=6A267CAB", "width": 640, "is_spatial_image": false}]}, "original_width": 1440, "original_height": 1440, "featured_products": []}], "like_count": 54093, "has_liked": false, "top_likers": ["rss.mtt"], "facepile_top_likers": [{"strong_id__": "713329593", "pk": "713329593", "pk_id": "713329593", "id": "713329593", "username": "rss.mtt", "full_name": "Mattia Rossi 🌊", "is_private": false, "is_verified": false, "profile_pic_id": "3669299857290781556_713329593", "profile_pic_url": "https://scontent-mxp1-1.cdninstagram.com/v/t51.82787-19/514862270_18516205495049594_8556620336802317856_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=102&_nc_oc=Q6cZ2gEBlvz7YlOfFwaUgJLXHBgvCZTTmMPtm-RCFkn2Iw_xNDlcvmsfuETKFsxTrADYbk4&_nc_ohc=ggic0EBBPvcQ7kNvwG-aPPq&_nc_gid=2pptiEQ48nSiC4d9y4DN5Q&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af92JSmMYRXb4izcjqV33satN_Aeb1OFMdJiQPPXUcuEsA&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18068806498612737", "bit_flags": 0, "created_at": 1727353791, "created_at_utc": 1727353791, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18068806498612737", "share_enabled": false, "content_type": "comment", "media_id": "3465593259512040098", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Con immenso gaudio le nostre personalitá vi annunciano che domani alle ore 14.00 saranno disponibili al link in bio i biglietti per TRE NUOVE DATE di Avanguardia Pura: San Marino, Lugano e La spezia. Siamo troppo felici di come state accogliendo questo tour. \nNotizia meno felice ma che gestiremo al meglio: abbiamo dovuto rischedulare le due date di Milano (che erano sold out) e la data di Sassari, perchè coincidono con la settimana di Sanremo, che purtroppo è stata modificata all’ultimo. \nPer chi ha già i vecchi biglietti SARANNO VALIDI per le nuove date, senza dover fare nulla. Per chi non potesse più venire nelle nuove date puó ovviamente chiedere il rimborso. \n\nArcimboldi 11 febbraio—> diventa 12 Marzo\nArcimboldi 12 febbraio—> diventa 13 Marzo \nSassari 15 febbraio—> diventa 22 Febbraio \n\nSperiamo possiate venire tutti e tutte. Vi vogliamo mega bene, a domani! Ore 14!", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gEBlvz7YlOfFwaUgJLXHBgvCZTTmMPtm-RCFkn2Iw_xNDlcvmsfuETKFsxTrADYbk4&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=2pptiEQ48nSiC4d9y4DN5Q&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9gEC47d8fNdFNQgMLAtrQ-_x8XkFXSXuU28um5Z4Yy2Q&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "With immense pleasure our personalities announce that tomorrow at 14.00 the tickets for THREE NEW DATES of Pure Avant-garde will be available at the link in bio: San Marino, Lugano and La spice. We are so happy with how you are welcoming this tour.\nLess happy news but we will manage it better: we had to reschedule the two dates of Milan (which were sold out) and the date of Sassari, because they coincide with the week of Sanremo, which was unfortunately modified to the latter.\nFor those who already have the old tickets, they WILL BE VALID for the new dates, without having to do anything. For those who couldn’t come on the new dates, you can of course ask for a refund.\n\nArchimboldi February 11—> becomes March 12\nArchimboldi February 12—> becomes March 13\nSassari February 15—> becomes February 22\n\nWe hope you all can come. We love you so much, see you tomorrow! 2 pm!"}, "comment_count": 141, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_e
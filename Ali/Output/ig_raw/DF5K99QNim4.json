_nc_cat=101&_nc_oc=Q6cZ2gGDOOSAyOXBb54CTaEtcCEWHL8cR5CQD3j3OqX7Sus6WKxx7iucDNcxIrNZRWS3XSI&_nc_ohc=_HVVVrmyC7cQ7kNvwGgxqrQ&_nc_gid=xiXA6mnXfwbDzxGmo7AjBg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-GDQatzd-p915RTmbLfg2FpJgW5SqiVh1U33po43Kqfw&oe=6A265F9B&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17928139907904002", "bit_flags": 0, "created_at": 1739192654, "created_at_utc": 1739192654, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17928139907904002", "share_enabled": false, "content_type": "comment", "media_id": "3564928818163886520", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Certi amori non finiscono, fanno dei giri immensi e poi ritornano, ebbene sì: siamo tornate.\nÈ con l’inizio della settimana santa di Sanremo che possiamo ufficializzarvi il ritorno di “Tutte le volte che” Sanremo ediscio, con una puntata scrocchiarella per voi, ogni mattina da domani. \nNon vediamo l’ora di chiacchierare con gli artisti in gara che passeranno a trovarci, ma non potevamo non aprire la stagione con il padrone di casa: Carlo Conti. Domani mattina sarà online la puntata e non vediamo l’ora di farci questo Sanremo con voi commentando le puntate come se fossimo tutti insieme sul nostro divano. A domani, si riparte! ❤️\n\nTutte Le Volte Che Sanremo Ediscio è una produzione @showreel_factory per @onepodcast_ in collaborazione con @spotifyitaly", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGDOOSAyOXBb54CTaEtcCEWHL8cR5CQD3j3OqX7Sus6WKxx7iucDNcxIrNZRWS3XSI&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=xiXA6mnXfwbDzxGmo7AjBg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-PnImgWoEzPUwu6L6sJuwT-UFtTXFx-TfP1bZ28FTZpw&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Some loves don’t end, they make huge trips and then they come back, although yes: we’re back.\nIt is with the beginning of the Sanremo holy week that we can officially make you the return of “Tutte le verte che” Sanremo edition, with a scrumptious episode for you, every morning from tomorrow.\nWe can’t wait to chat with the competing artists who will visit us, but we couldn’t resist opening the season with the host: Carlo Conti. Tomorrow morning the episode will be online and we can’t wait to do this with you commenting on the episodes as if we were all together on our sofa. See you tomorrow, here we go again! ❤️\n\nTutte Le Volte Che Sanremo Ediscio is a @onepodcast_ production for @spotifyitaly in collaboration with @showreel_factory"}, "comment_count": 187, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null
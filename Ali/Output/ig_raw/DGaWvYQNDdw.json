0336802317856_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=102&_nc_oc=Q6cZ2gG1xdMte-n3gjpt6_gmgRbFt7ykLzFYO2PqHEghWe23_2_GU2zQ1dFiN0PcyUjbPMg&_nc_ohc=ggic0EBBPvcQ7kNvwG-aPPq&_nc_gid=wRWaCYkuutheKh0cYSsBdA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af90CWkdf6unRc_ZtY9FVuQ57v7wiRrVid01sl7ZTJ9DQw&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18156973930341711", "bit_flags": 0, "created_at": 1740306122, "created_at_utc": 1740306122, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18156973930341711", "share_enabled": false, "content_type": "comment", "media_id": "3574269267152222064", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "“A volte, non capisco chi io sia, cosa stia facendo o forse dovrei dire che mi perdo di vista. Non ho la sensazione di essere me stesso, di vivere la mia vita. In quei momenti mi percepisco come un’ombra. Ho l’impressione di vivere fingendo di essere me, imitando alla perfezione tutto quello che faccio”. \n\nCi sono libri che per lo stato d’animo con cui li leggi, te li ricorderai per sempre. Questo è uno di quelli.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gG1xdMte-n3gjpt6_gmgRbFt7ykLzFYO2PqHEghWe23_2_GU2zQ1dFiN0PcyUjbPMg&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=wRWaCYkuutheKh0cYSsBdA&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_9Nqu7BJzgTe5a4uS7ljTD9onc3cMYJGFlkHw3kWvXIQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "“A volte, non capisco chi io sia, cosa stia facendo o forse dovrei dire che mi perdo di vista. Non ho la sensazione di essere me stesso, di vivere la mia vita. In quei momenti mi percepisco come un’ombra. Ho l’impressione di vivere fingendo di essere me, imitando alla perfezione tutto quello che faccio”. \n\nThere are books that because of the mood you read them, you will remember them forever. This is one of those."}, "comment_count": 80, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_tab": null, "fan_consideration_page_revamp_eligiblity": null}, "friendship_status": {"following": true, "is_bestie": false, "is_feed_favorite": false, "is_private": false, "is_restricted": false, "followed_by": f
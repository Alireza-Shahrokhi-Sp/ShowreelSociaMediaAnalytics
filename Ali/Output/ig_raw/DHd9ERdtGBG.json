3_18500526103038266_5516838251339524147_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=108&ig_cache_key=MzU5MzI5NjY0NTY0Mzg5NTAzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMzIwLnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=p2pySiCTnysQ7kNvwFkG9i5&_nc_oc=Adp34cbVdDaEWrjX4m7n9QSaMiGhrrpZKUgXmRp0tRRnMke1QrKVSmEtKu4TuviUHL8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=cVaJyQ5pJWrnc0QtibBHWw&_nc_ss=7a22e&oh=00_Af_JCm0p06d4AeKchAXoCTCwXTrE5lP0ib9cJPgYbzaR2A&oe=6A266CDF", "width": 320, "is_spatial_image": false}, {"estimated_scans_sizes": [], "height": 400, "scans_profile": null, "url": "https://scontent-mxp1-1.cdninstagram.com/v/t51.75761-15/485239073_18500526103038266_5516838251339524147_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=108&ig_cache_key=MzU5MzI5NjY0NTY0Mzg5NTAzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMzIwLnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=p2pySiCTnysQ7kNvwFkG9i5&_nc_oc=Adp34cbVdDaEWrjX4m7n9QSaMiGhrrpZKUgXmRp0tRRnMke1QrKVSmEtKu4TuviUHL8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_gid=cVaJyQ5pJWrnc0QtibBHWw&_nc_ss=7a22e&oh=00_Af_JCm0p06d4AeKchAXoCTCwXTrE5lP0ib9cJPgYbzaR2A&oe=6A266CDF", "width": 320, "is_spatial_image": false}]}, "original_width": 320, "original_height": 400, "featured_products": []}], "like_count": 3, "has_liked": false, "top_likers": ["rosannaterrenghi"], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17923499966944229", "bit_flags": 0, "created_at": 1742574363, "created_at_utc": 1742574363, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17923499966944229", "share_enabled": false, "content_type": "comment", "media_id": "3593296652178579526", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Raga non per dire ma a voi non sembra che le ruote dei carrelli dovrebbero darsi una gran calmata? Ma dove cazzo pensano di andare? Ma avete capito cosa significa andare dritte? Ma potete mettervi d’accordo e andare tutte nella stessa direzione o avete cinque anni che ognuna deve fare come ca**o le pare? Mi sembra di stare all’asilo e invece siamo al supermercato cioè chi mi vede da fuori portare il carrello come minimo pensa che ho la labirintite o che penso di essere agli autoscontri.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHxMyj-8mB3dpsTm0AZnkj-9YK1v4YE8uR0uxAn8eStK_NM5YpQlJRHEAE80K7CzgI&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=cVaJyQ5pJWrnc0QtibBHWw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9CUiqwU5FG2DQLkw9kdOKsN4bzTGmXHcb2tEnu4L7nTQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Girl, I don't want to say but to you it seems that the wheels of the carts should calm down? Where the fuck are they thinking of going? Have you understood what it means to go straight? But can you all agree and go in the same direction or do you have five years that each of them has to do as the fuck they please? I feel like I’m in kindergarten and instead we’re at the supermarket, meaning if anyone sees me carrying a trolley from outside thinks I have a maze or that I’m in a car crash."}, "comment_count": 77, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_po
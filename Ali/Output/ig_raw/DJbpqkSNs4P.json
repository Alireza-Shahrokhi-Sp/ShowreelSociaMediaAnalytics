a1IMHm8Wc4lcynvc5OjiUCViLalkQM6RRqGf46_A&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18059363275921539", "bit_flags": 0, "created_at": 1746792123, "created_at_utc": 1746792123, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18059363275921539", "share_enabled": false, "content_type": "comment", "media_id": "3628677169862331919", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Una cosa che voglio fare: tagliare la cima di tutte le calze. Non sopporto le cose che stringono: gli elastici, le cinture, le code gellate, gli orologi, i colli alti; i colli alti non li sopporto. Oggi ho tagliato la cima di un paio di calze, prima mi sono sentita in colpa, le ho rovinate, ho pensato. Poi quando le ho messe, comode comode, che stavano lì anche senza aggrapparsi, senza costringere, mi son sentita proprio bene, ah come mi sono sentita bene.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHHRvlDVAdDoxpiqB10-_kiNpyfCczJjKDgU7MLz6Rw82wjDs9PXbs21vy73QWGHj0&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=pgqO81UJlSm9CQpXnLVOHw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af81HrPrn7jaHmyL1xzZ-B0oHp3HOPjli1KOcS7V5b0Fsg&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "One thing I want to do: cut the top off of all socks. I can't stand tight things: rubber bands, belts, frozen tails, watches, high necks; high necks. I cut the top of a pair of socks today, I felt guilty at first, I ruined them, I thought. Then when I put them on, comfortable comfortable, that stayed there even without holding on, without forcing, I felt really good, ah how it felt."}, "comment_count": 218, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_tab": null, "fan_consideration_page_revamp_eligiblity": null}, "friendship_status": {"following": true, "is_bestie": false, "is_feed_favorite": false, "is_private": false, "is_restricted": false, "followed_by": false, "is_muting_reel": false}, "hd_profile_pic_url_info": {"height": 719, "url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHHRvlDVAdDoxpiqB
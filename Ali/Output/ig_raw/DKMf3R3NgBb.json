150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp1-1.cdninstagram.com&_nc_cat=102&_nc_oc=Q6cZ2gFdqbiB5aXd5zAfkHvnVt0uhLz_XsAQ-ZP4UTua76yQrhzXp1hvCe-QPUdjA4vzMHw&_nc_ohc=ggic0EBBPvcQ7kNvwG-aPPq&_nc_gid=bJPWyURxNnDx2-wRsBAtrw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_8CMaqk-qdbidDymrzWaK300ZBzoPgxHTIi41qj9Xbgg&oe=6A266925&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18086351437656688", "bit_flags": 0, "created_at": 1748431079, "created_at_utc": 1748431079, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18086351437656688", "share_enabled": false, "content_type": "comment", "media_id": "3642426336828850267", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "ma perchè quando si risponde al telefono si dice pronto? Cioè se uno ti chiama è ovvio che è pronto (cosí come se uno risponde) se no ti avrebbe chiamato in un alto momento (o non avrebbe risposto); se cosí non fosse potrebbe svolgersi una conversazione tipo “pronto scusa non sono pronto” “No ma figurati manco io, è buffo perchè ho chiamato io ma mi servono altri 5 minuti, dai ti richiamo”. Non so secondo me dovremmo cambiare modo di rispondere al telefono ecco tutto.", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gFdqbiB5aXd5zAfkHvnVt0uhLz_XsAQ-ZP4UTua76yQrhzXp1hvCe-QPUdjA4vzMHw&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=bJPWyURxNnDx2-wRsBAtrw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af8cuI6o9gf8Ag69k6dtVv0nHKoa8mXwIspcQ4T2pNSolw&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "But why is it that when you answer the phone you say you’re ready? That is, if someone calls you, it's obvious that they're ready (just like if you answer) otherwise they would have called you in a high time (or wouldn't answer); if it wasn't so, there could be a conversation like \"ready sorry I'm not ready\" \"No but figure it out I'm missing, it's funny because I called, but I need another 5 minutes, come on, I'll call you back. I don’t know in my opinion we should change the way we answer the phone that’s all."}, "comment_count": 111, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_tab": null, "fan_consideration_page_revamp_eligiblity": null}, "friendship_status": {"follo
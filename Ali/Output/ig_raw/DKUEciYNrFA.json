hed": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHtpJc4iv9UcGR2NnzqUIDlxTNbDhlGL3j-pRG5eVsAzHz9FrBWg271uByYCjAHXbQ&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=Yfs4cKMMj5YhFlQybTYjQg&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9l9uXCiBTurgMN7xZgonFK1yuk1ac-qeK-7E92noCq7w&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "I read three books in May.\nI liked one like that, but it was important to understand some things.\nI really liked one and will talk to you soon.\nOn the other hand, I really liked this and if you’re looking for something to make you laugh or cry, Holden is for you.\nCaulfield I'll miss you."}, "comment_count": 134, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null
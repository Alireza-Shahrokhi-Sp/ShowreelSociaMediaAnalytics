77284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGCO1AZAYobFCdfLusDtZbhpYj5CMjwvmQXC74gMJx1SA6ow6_jgat3xgU640-oglM&_nc_ohc=HHEghLUzHLcQ7kNvwEy0YwI&_nc_gid=O27jk97Wfz8ka006z90kzQ&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af-ByE-8ow2NCBaFxQ-x7P-NRDmeAYJYm9nI1vEmDXXjnQ&oe=6A266AEC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "This morning I found a note on my phone that is very old and it reads: Remind you of the giant dinosaur. I don't know what I meant and I don't think I remembered the giant dinosaur but I think it was a good day if that was something I definitely shouldn't forget."}, "comment_count": 95, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "shop_routing_user_id": null, "featured_products": [], "user": {"strong_id__": "15526265", "fbid_v2": "17841401147950242", "feed_post_reshare_disabled": false, "id": "15526265", "is_unpublished": false, "pk": "15526265", "pk_id": "15526265", "third_party_downloads_enabled": 2, "eligible_for_text_app_activation_badge": false, "account_type": 3, "can_see_quiet_post_attribution": true, "account_badges": [], "full_name": "Camihawke", "has_anonymous_profile_picture": false, "is_favorite": false, "is_private": false, "is_ring_creator": false, "show_ring_award": false, "is_verified": true, "show_account_transparency_details": true, "transparency_product_enabled": false, "username": "camihawke", "user_activation_info": {}, "fan_club_info": {"autosave_to_exclusive_highlight": null, "connected_member_count": null, "fan_club_id": null, "fan_club_name": null, "has_created_ssc": null, "has_enough_subscribers_for_ssc": null, "is_fan_club_gifting_eligible": null, "is_fan_club_referral_eligible": null, "is_free_trial_eligible": null, "largest_public_bc_id": null, "subscriber_count": null, "should_show_playlists_in_profile_
bNh8tfFBKSs4l6E6gom0xTYeUbzPJrgpPcsQ&oe=6A2632AC&_nc_sid=fc8dfb"}, "audio_filter_infos": null, "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 30962, "fb_like_count": 1133, "has_liked": false, "top_likers": [], "facepile_top_likers": [], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18082563418995703", "bit_flags": 0, "created_at": 1771507554, "created_at_utc": 1771507554, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18082563418995703", "share_enabled": false, "content_type": "comment", "media_id": "3836003874331180272", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "È online su YouTube il video di oggi, si chiama a domanda rispondo e come suggerisce il nome ho risposto a tante delle domande che mi avete fatto ieri. Si parla di molte cose, in uno spazio sicuro. Mi piacerebbe davvero sapere che ne pensate, non solo del format ma anche di ció di cui si è parlato. \nIl link è in bio. \nVi leggo nei commenti ♥️ (qui e su YT)", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdnin
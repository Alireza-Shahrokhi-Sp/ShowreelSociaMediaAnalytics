ECAywv-ZGVLCnn_TQh6coOSDW2Gs8xZl0&_nc_ohc=ggic0EBBPvcQ7kNvwE1WWP6&_nc_gid=dPWIRJA6CwVFhXZyv0Zlkw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_VznrW4v-5frOk8y6AhzSAFY6FhK41WSXaR5Qgr7VgFA&oe=6A2630E5&_nc_sid=fc8dfb"}, {"strong_id__": "4435826923", "pk": "4435826923", "pk_id": "4435826923", "id": "4435826923", "username": "edosagli", "full_name": "EdoSagli", "is_private": true, "is_verified": false, "profile_pic_id": "3908983157689037550_4435826923", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.82787-19/710908911_18402438172146924_3870595692934395467_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=100&_nc_oc=Q6cZ2gHwWzkq3FYT-SnzJNKDO-Mm6tmkwXoA46ECAywv-ZGVLCnn_TQh6coOSDW2Gs8xZl0&_nc_ohc=CC8P3bn5F6gQ7kNvwEU4yvb&_nc_gid=dPWIRJA6CwVFhXZyv0Zlkw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af9eM90ZshQEjkKtw4gpW74qieaiFisGlJ5KT7Zz8niRQQ&oe=6A262455&_nc_sid=fc8dfb"}], "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17906961768186388", "bit_flags": 0, "created_at": 1771757906, "created_at_utc": 1771757906, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17906961768186388", "share_enabled": false, "content_type": "comment", "media_id": "3838101269634352805", "status": "Active", "type": 1, "user_id": "15526265", "has_translation": true, "text": "Alla domanda se mi hanno fatto mai pesare di non avere ancora figli ho detto sì, e credo che nel 2026 far coincidere ancora l’idea di realizzazione di una donna con la sua sola maternità sia veramente imbarazzante. Amo i bambini e desidererei averne, ma ora sono felice così, perché la mia vita è già piena. Quando e se sarà, sarò felicissima, se non sarà, saró lo stesso felicissima. Queste per me sono le basi per una famiglia felice. (NB La famiglia, poi, non è solo quella composta da genitori e figli, vi prego, non siamo nel medioevo).", "user": {"strong_id__": "15526265", "pk": "15526265", "pk_id": "15526265", "id": "15526265", "is_unpublished": false, "fbid_v2": "17841401147950242", "username": "camihawke", "full_name": "Camihawke", "is_private": false, "is_verified": true, "profile_pic_id": "3599963566846179660_15526265", "profile_pic_url": "https://scontent-mxp2-1.cdninstagram.com/v/t51.2885-19/487361057_684224477284393_7381724342902909070_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43MTkuYzIifQ&_nc_ht=scontent-mxp2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHwWzkq3FYT-SnzJNKDO-Mm6tmkwXoA46ECAywv-ZGVLCnn_TQh6coOSDW2Gs8xZl0&_nc_ohc=HHEghLUzHLcQ7kNvwEwpMSc&_nc_gid=dPWIRJA6CwVFhXZyv0Zlkw&edm=ALQROFkBAAAA&ccb=7-5&oh=00_Af_EQHd12EJWCEcfQu2Jl7Tu5Pwny3tiDpsGU4dW9qQJkA&oe=6A2632AC&_nc_sid=fc8dfb"}, "is_covered": false, "private_reply_status": 0, "text_translation": "When asked if I have ever been weighed that I don’t have children yet I said yes, and I think that in 2026 coinciding with the idea of a woman’s achievement with her own motherhood is really embarrassing. I love kids and wish I had some but now I'm happy like this because my life is already full. When and if it happens, I'll be very happy, if it doesn't happen, I'll still be very happy. For me, these are the basis of a happy family. (NB The family, then, is not just the one made up of parents and children, please, we are not in the middle ages)."}, "comment_count": 1695, "can_view_more_preview_comments": false, "preview_comments": [], "comment_likes_enabled": true, "play_count": 3602472, "ig_play_count": 3371349, "fb_play_count": 231123, "shop_routing_user_id": null, "featured_products": [], "video_duration": 62.41600036621094, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPrese
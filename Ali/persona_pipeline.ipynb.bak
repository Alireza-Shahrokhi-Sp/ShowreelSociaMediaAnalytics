                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Avg word count: \u003c5\u0027,\n",
                                                                          "   \u0027Activity span: Long-term (1500+ days)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Altro che Virgin Active 😂😂😂\u0027, \u0027Che bomba 😮😍👏\u0027, \u0027❤️❤️❤️❤️❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE APPRECIATOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona engages sporadically over a long period, using minimal words and many emojis to convey general positive reactions to both aspirational and humorous content.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: Low (1-2)\u0027,\n",
                                                                          "   \u0027Activity span: Long-term (600+ days)\u0027,\n",
                                                                          "   \u0027Avg word count: 0-1\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027😂\u0027, \u0027Wow❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE HELPFUL SUGGESTER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona engages directly with calls-to-action, offering concise and relevant suggestions or answers, typically without emojis.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Engages with interactive posts (e.g., asking for names/ideas)\u0027,\n",
                                                                          "   \u0027Avg word count: 5+\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): 100%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027La Tana Direi sia adatto\u0027,\n",
                                                                          "   \u0027Siamo tutti PIENIH CON UN H FINALE\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE REACTIVE TAGGER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona engages by tagging friends in comments, often accompanied by a single emoji, indicating shared humor or content they want to share.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 1-2 (often just a tag)\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0% (but tags others)\u0027,\n",
                                                                          "   \u0027Engages with humorous/relatable content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@__iman__sah 😂😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE EMOTICON ENTHUSIAST\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A highly consistent and long-term follower who expresses appreciation primarily through emojis and short, positive exclamations, without engaging in deeper conversation.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: high\u0027,\n",
                                                                          "   \u0027Activity span: long\u0027,\n",
                                                                          "   \u0027Avg word count: 1\u0027,\n",
                                                                          "   \u0027Emoji rate: 96%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027⚡️⚡️\u0027, \u0027❤️❤️❤️\u0027, \u0027Bella ❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE VIBE CHECKER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who leaves a single, concise comment to affirm the overall mood or aesthetic of a post, often using contemporary slang.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Activity span: 0 days\u0027,\n",
                                                                          "   \u0027Avg word count: 6\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Questa è la vibes che vogliamo\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE MORAL COMPASS\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who engages with a single, lengthy comment to share a thoughtful, often critical or philosophical, perspective on broader societal issues related to online behavior.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Activity span: 0 days\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: 0.8h\u0027,\n",
                                                                          "   \u0027Avg word count: 77\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Purtroppo il nascondersi dietro a uno schermo ha dato una scusa alle persone a dare il peggio di sé e a sfogare le proprie frustrazioni.\u0027,\n",
                                                                          "   \u0027Ma il web non è una realtà virtuale fatta di automi ma composta da persone reali.\u0027,\n",
                                                                          "   \u0027È desolante leggere i commenti in giro per la rete, finti moralisti pronti a scaricare quintali di bile senza alcuna ragione.\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE ADMIRER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who leaves a single, very short, and direct comment expressing physical admiration for the influencer.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Activity span: 0 days\u0027,\n",
                                                                          "   \u0027Avg word count: 2\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Sei bona\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE TAGGER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user whose sole interaction is to tag another user, indicating they want to share the content with someone specific.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Activity span: 0 days\u0027,\n",
                                                                          "   \u0027Avg word count: 1\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@mihaelagangura\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EMOJI_REACTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user expresses immediate, non-verbal reactions to visually engaging content, often with a single emoji.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 0\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Comments on dynamic or humorous visual content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027SOCIAL_SHARER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user primarily engages by tagging friends, indicating a desire to share content they find relevant or amusing with their network.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: low (often just tags)\u0027,\n",

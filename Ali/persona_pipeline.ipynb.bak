                                                                          "  \u0027examples\u0027: [\u0027@silviacerigioni l ho quasi imparata occhioooooo\u0027,\n",
                                                                          "   \u0027@marucciji io per esempio ho la sindrome di peter pan !! O di peppa pig o pepper Ann..cacchio non ricordo più 🤦🏻\\u200d♀️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EARLY_APPRECIATOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user is quick to react to new content, often with short, enthusiastic, and emoji-heavy comments, indicating strong initial engagement.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Early commenter (\u003c1h): \u003e50%\u0027,\n",
                                                                          "   \u0027Avg word count: 1-2\u0027,\n",
                                                                          "   \u0027Emoji rate: \u003e50%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@sophiadametto 😍😍😍😍\u0027, \u0027TGICami\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE ENTHUSIAST\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona expresses strong positive emotions, often tags friends to share content, and engages with posts that evoke admiration or shared sentiment.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027High emoji rate (often 0% or 100%)\u0027,\n",
                                                                          "   \u0027Tags other users in comments\u0027,\n",
                                                                          "   \u0027High question rate (often rhetorical)\u0027,\n",
                                                                          "   \u0027Engages with personal stories or visually appealing content\u0027],\n",

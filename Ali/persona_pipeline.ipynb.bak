                                                                          "  \u0027examples\u0027: [\u0027Bellissimo!\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027RELATABLE_LAUGHER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona engages with humorous content, expressing strong personal identification and amusement, often using emojis.\u0027,\n",

                                                                          " {\u0027codename\u0027: \u0027THE ENTHUSIASTIC ADMIRER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A highly expressive commenter who focuses on physical appearance, uses many emojis, and offers unsolicited advice or compliments.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Single comment, high emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Focus on physical attributes (freckles)\u0027,\n",
                                                                          "   \"Expressive language (\u0027camivigliose\u0027)\"],\n",
                                                                          "  \u0027examples\u0027: [\u0027Non coprirti le lentiggini!!!! 😍😍😍😍😍😍😍Sono così camivigliose!!!\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE HELPFUL SUGGESTER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who provides practical advice or recommendations, commenting early and directly without excessive emotional display.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Single comment, early commenter (100% \u003c1h)\u0027,\n",
                                                                          "   \u0027Low emoji rate (0%)\u0027,\n",
                                                                          "   \u0027Direct, practical suggestion\u0027,\n",
                                                                          "   \u0027Engagement with travel/experience-sharing content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Se posso suggerisco anche Gand, bellissima!\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE RELATABLE RESPONDER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who engages by relating the content to their own experience or feelings, often in response to a direct or implied question from the influencer.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Single comment, high emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Reply ratio (100%)\u0027,\n",
                                                                          "   \u0027Short, personal reaction\u0027,\n",
                                                                          "   \u0027Engagement with humorous/relatable content (zodiac signs)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@_frawless sembra quasi mi conosca... 😮\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE CURIOUS CONSUMER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A user who asks specific questions about items or details shown in the content, indicating an interest in practical information.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Single comment, early commenter (100% \u003c1h)\u0027,\n",
                                                                          "   \u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027High question rate (100%)\u0027,\n",
                                                                          "   \u0027Specific product/item inquiry\u0027,\n",
                                                                          "   \u0027Engagement with home decor/lifestyle content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Dove hai preso quel mobile/ cantinetta vini? 🤩\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027SUPERFAN\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona is a highly engaged, long-term follower who expresses strong positive sentiment and appreciation, often with a personal touch, across various content types.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Activity span: \u003e1 year\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): \u003e50%\u0027,\n",
                                                                          "   \u0027Avg word count: \u003e5\u0027,\n",
                                                                          "   \u0027Emoji rate: \u003e50%\u0027,\n",
                                                                          "   \u0027Engages with both sponsored and personal content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027👏👏👏👏👏\u0027,\n",
                                                                          "   \u0027🙌\u0027,\n",
                                                                          "   \u0027Che dire...anche a capitomboli saresti strepitosa!!! Ps: notare la parola “ capitomboli” che tradisce il mio perugino!\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EMOJI_APPRECIATOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona expresses quick, positive, and often non-verbal appreciation primarily through emojis, typically with short, one-off interactions.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: \u003c2\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0%\u0027,\n",
                                                                          "   \u0027Comments on diverse content (e.g., books, personal milestones)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027❤️\u0027, \u0027❤️❤️❤️👏👏\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027SOCIAL_CONNECTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona uses comments to tag friends, sharing content they find amusing or relevant to their social circle, often with minimal additional text.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: \u003c5\u0027,\n",
                                                                          "   \u0027Emoji rate: \u003e50%\u0027,\n",
                                                                          "   \u0027Comments contain @mentions of other users\u0027,\n",
                                                                          "   \u0027Engages with humorous or relatable content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@agnetoga87 @bennipeyton @giuliazaniboni_soprano @martcasti 😂😂😂\u0027,\n",
                                                                          "   \u0027@heitsfabs 😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EMOTIONAL_RESPONDER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user expresses strong, often empathetic emotions through emojis and short, heartfelt comments, typically on deeply personal or touching content.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Avg word count: 1-2\u0027,\n",
                                                                          "   \u0027Comments on emotional/personal posts\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027😭😭❤️❤️❤️\u0027, \u0027Amore ❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027CHEERLEADER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user offers enthusiastic praise and congratulations, often using a mix of positive words and celebratory emojis, especially for posts showcasing achievements or positive experiences.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Avg word count: 2\u0027,\n",
                                                                          "   \u0027Comments on achievement/celebratory posts\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027💪🏼👏🏻👏🏻 braviiii 🤩\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027ENGAGED_FRIEND\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user actively engages with the influencer\u0027s content by tagging friends, asking questions, and reminiscing about shared experiences, indicating a personal connection.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Reply ratio: 0% (but tags others)\u0027,\n",
                                                                          "   \u0027Avg word count: 9\u0027,\n",
                                                                          "   \u0027Emoji rate: 50%\u0027,\n",
                                                                          "   \u0027Question rate: 50%\u0027,\n",
                                                                          "   \u0027Comments on posts featuring friends or past events\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@eleonoragalloni 😂 potremmo replicare anche noi e far tornare il poliedrico trio😏😏😏\u0027,\n",
                                                                          "   \u0027@eleonoragalloni ma solo a noi eravamo imbarazzanti???\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027ATTENTION_SEEKER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user\u0027s primary interaction is to tag another user, often without additional text, suggesting an attempt to draw that person\u0027s attention to the post.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 1\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Comment consists solely of a tag\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@gaiacaranna\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE_SHARER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user primarily uses posts as a means to tag friends, sharing content they find relevant or interesting to their network.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 2-5\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027,\n",
                                                                          "   \u0027Comment contains @mentions\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@marco_terrizzi tropea\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE_DEFENDER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user engages with the comment section, often defending the influencer\u0027s content or correcting misinterpretations from other users.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: \u003e24h\u0027,\n",
                                                                          "   \u0027Avg word count: \u003e20\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Chi non ha capito che questo video è puro sarcasmo alzi la mano.\u0027,\n",
                                                                          "   \u0027Perché leggo davvero commenti che stanno qui ad insegnare cose che ormai anche i bambini sanno.\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE_ALGO_BOOSTER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user comments specifically to support the influencer by boosting engagement, often explicitly mentioning the algorithm.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 4\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027,\n",
                                                                          "   \"Comment explicitly mentions \u0027algoritmo\u0027\"],\n",
                                                                          "  \u0027examples\u0027: [\"Commento per l\u0027algoritmo birbone\"]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE_NOSTALGIC_CONNECTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user connects the influencer\u0027s content to personal memories or shared cultural references, sometimes tagging friends to share the nostalgia.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: \u003e1\u0027,\n",
                                                                          "   \u0027Activity span: \u003e1 year\u0027,\n",
                                                                          "   \u0027Avg word count: 6-20\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Comment often references past experiences or specific cultural items\u0027],\n",
                                                                          "  \u0027examples\u0027: [\"L\u0027Arminuta!\",\n",
                                                                          "   \"La cartellina trasparente di educazione tecnica era come l\u0027ombrello: se non serviva al ritorno da scuola era dimenticata e persa\",\n",
                                                                          "   \u0027Lemony Snicket!\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE_JOKESTER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user engages with the influencer\u0027s humor, often by playing along with a joke or asking a clarifying question in a playful tone.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 5\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Question rate: 100%\u0027,\n",
                                                                          "   \u0027Comment contains a joke or playful question\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@marilu_ferrarelli “Tulipani” in questo senso? 😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE PUZZLER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user engages deeply with interactive content, often participating in challenges or riddles, and shows a long-term, albeit infrequent, engagement pattern.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Activity span: 1818 days (long-term)\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: 987.0h (delayed engagement)\u0027,\n",
                                                                          "   \u0027Question rate: 25%\u0027,\n",
                                                                          "   \u0027Engages with interactive posts (riddles, polls, advice-seeking)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@asiaaddari io ne ho uno Il padre di Pierino ha 3 figli, Qui Quo e……????\u0027,\n",
                                                                          "   \u0027@asiaaddari il fatto che nessuno risponda mi fa capire la sua complessità!!!!!!\u0027,\n",
                                                                          "   \u0027@nunziamaiiii bravaaa 😂😂😂 nella foga di rispondere velocemente, quando lo dici a voce, rispondono tutti Qua😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE TAGGER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user primarily engages by tagging friends in relevant content, often with a personal anecdote or inside joke, indicating a social sharing behavior.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Reply ratio: 100% (implies tagging a friend in a reply)\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Avg word count: 19 (descriptive tags)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\"@marty_dolo ti dico solo che l\u0027altra sera ha bevuto un calice di vino e le è pure piaciuto 😂 #falsa 😂🧡\"]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE FRIEND-CALLER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user\u0027s engagement is limited to tagging a friend, suggesting they use the influencer\u0027s content as a prompt for direct communication rather than public commentary.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 1\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Comment consists solely of an @mention\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@18lucy98\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE APPRECIATOR\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user offers direct, positive feedback, often focusing on the influencer\u0027s appearance or the aesthetic quality of the post, with quick, enthusiastic comments.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): 100%\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Avg word count: 4 (short, direct praise)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u00272 sei troppo bella 🔥\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE RELATABLE-TAGGER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user tags friends in content they find relatable or humorous, often connecting the post\u0027s theme to a shared personal experience.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Reply ratio: 100% (implies tagging a friend in a reply)\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: 23.4h (delayed, but still within a day)\u0027,\n",
                                                                          "   \u0027Engages with humorous or relatable content (e.g., struggles with design/purchases)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@veronica_dottavio quando ti prendi la laurea in design in modalità telematica\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE CHEERLEADER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A highly supportive and empathetic follower who consistently offers encouragement and congratulations, often using emojis to convey emotion and engaging with personal and career milestone posts.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Low average word count (3)\u0027,\n",
                                                                          "   \u0027Consistent positive sentiment\u0027,\n",
                                                                          "   \u0027Engagement with posts about personal feelings and career achievements\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027In bocca al lupo.... 🐺💜\u0027,\n",
                                                                          "   \u0027Grande, te lo meriti! 😍\u0027,\n",
                                                                          "   \u0027Auguri 💜\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE ADMIRER\u0027,\n",
                                                                          "  \u0027description\u0027: \"A follower who expresses consistent admiration for the influencer\u0027s appearance and style, using short, effusive compliments and emojis.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Very low average word count (2)\u0027,\n",
                                                                          "   \u0027Focus on aesthetic praise\u0027,\n",
                                                                          "   \u0027Engagement with fashion/glamour-focused content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Favolosa❤️\u0027, \u0027Splendida ❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE CASUAL ENGAGER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027An infrequent commenter who leaves short, lighthearted, and often emoji-driven reactions to posts, typically without deep engagement.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Very low total comments (1)\u0027,\n",
                                                                          "   \u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Very low average word count (2)\u0027,\n",
                                                                          "   \u0027Sporadic activity\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Ahahahhaha ❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE SUPERFAN\u0027,\n",
                                                                          "  \u0027description\u0027: \"A highly active and enthusiastic follower who frequently comments with effusive praise, often using superlatives and emojis, showing deep appreciation for the influencer\u0027s content and personality.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027High total comments (8)\u0027,\n",
                                                                          "   \u0027High early commenter rate (62%)\u0027,\n",
                                                                          "   \u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Consistent positive and superlative language\u0027,\n",
                                                                          "   \u0027Engagement across various content types (humor, aesthetics, lifestyle)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Non sei bella, sei bellerrima ♥️\u0027,\n",
                                                                          "   \u0027Madonna che splendore 😍\u0027,\n",
                                                                          "   \u0027Sei imbattibile 😂♥️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE REFLECTIVE OBSERVER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A follower who offers concise, thoughtful, and often poetic interpretations or reactions to the emotional or artistic aspects of a post, typically without emojis.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Very low total comments (1)\u0027,\n",
                                                                          "   \u0027Zero emoji rate (0%)\u0027,\n",
                                                                          "   \u0027Quick to comment (early commenter 100%)\u0027,\n",
                                                                          "   \u0027Engagement with artistic or introspective content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Anime fragili\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027LATE_RELATER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user engages with content much later, often with short, relatable, and sometimes informal or exclamatory comments, identifying with the post\u0027s theme.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg hrs to comment: \u003e700h\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): 0%\u0027,\n",
                                                                          "   \u0027Avg word count: low (e.g., 2)\u0027,\n",
                                                                          "   \u0027Emoji rate: low (e.g., 0%)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Porko cane\u0027, \u0027Sono io\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EMOJI_EXPRESSER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A highly engaged and long-term follower who frequently uses emojis to express a range of emotions, often commenting quickly and across many posts.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: high (e.g., 10+)\u0027,\n",
                                                                          "   \u0027Unique posts: high (e.g., 10+)\u0027,\n",
                                                                          "   \u0027Activity span: long (e.g., \u003e1000 days)\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: low (e.g., \u003c2h)\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): high (e.g., 50%+) \u0027,\n",
                                                                          "   \u0027Emoji rate: high (e.g., 70%+)\u0027,\n",
                                                                          "   \u0027Avg word count: low (e.g., 2)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027👏👏👏\u0027, \u0027😂😂😂😂😂😂😂😂😂😂😂😂😂😂\u0027, \u0027In bocca al lupo. ❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027DEVOTED_FAN\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user expresses strong, direct affection or enthusiasm for the influencer, often with short, impactful statements.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: low (e.g., 1-2)\u0027,\n",
                                                                          "   \u0027Avg hrs to comment: low (e.g., 0h)\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): high (e.g., 100%)\u0027,\n",
                                                                          "   \u0027Avg word count: low (e.g., 2-8)\u0027,\n",
                                                                          "   \u0027Emoji rate: variable, but often present with positive sentiment\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Ti amo\u0027,\n",
                                                                          "   \u0027AAAAAAAAH ❤️ ragazzi non vedo l’ora di rivederviiiiiiiiiii\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027CASUAL_SHARER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user engages with humorous content by tagging friends, using minimal words, and relying heavily on emojis to convey their reaction.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 2\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0%\u0027,\n",
                                                                          "   \u0027Engages with humorous, relatable video content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@gpisanello 😂❤️\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027EMPATHIC_REFLECTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user connects deeply with emotional and nostalgic content, expressing thoughtful and personal sentiments in their comments.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 1\u0027,\n",
                                                                          "   \u0027Avg word count: 40\u0027,\n",
                                                                          "   \u0027Emoji rate: 100% (single, meaningful emoji)\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): 100%\u0027,\n",
                                                                          "   \u0027Engages with personal, nostalgic image posts\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Che belli i ricordi, che bello che le nonne conservavano tutto e scrivevano date e pensieri dietro ad ogni foto, dietro ad ogni appunto. In questo modo continuano a vivere, loro e i ricordi, anche quelli più piccoli. ♥️ @camihawke\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027ENGAGED_FOLLOWER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user actively participates by asking questions, expressing anticipation, and relating content to their own experiences, often using emojis.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 2+\u0027,\n",
                                                                          "   \u0027Avg word count: 10\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Question rate: 50%+\u0027,\n",
                                                                          "   \u0027Engages with both humorous reels and personal reflections\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Fanta in tutti i locali di Roma 😅....ora che sono grande però crodino eh!?! 😊\u0027,\n",
                                                                          "   \u0027Aspetto queste perle con ansia....! 👏😜\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027SOCIAL_CONNECTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user primarily uses comments to tag friends and initiate conversations, often with short, direct messages.\u0027,\n",

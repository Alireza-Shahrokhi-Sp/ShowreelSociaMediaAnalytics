                                                                          "   \u0027Avg word count: 4\u0027,\n",
                                                                          "   \u0027Reply ratio: 100%\u0027,\n",
                                                                          "   \u0027Emoji rate: 50%\u0027,\n",
                                                                          "   \u0027Engages with relatable, everyday life content (e.g., shopping humor)\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@_gaiafaraci una delle emozioni piu forti!\u0027,\n",
                                                                          "   \u0027@_gaiafaraci 😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027REFERRAL_TAGGER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user frequently tags others to draw their attention to specific content, often making observations or recommendations.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Total comments: 3+\u0027,\n",
                                                                          "   \u0027Avg word count: 7\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 33%+\u0027,\n",
                                                                          "   \u0027Engages with diverse content, from personal posts to collaborative reels\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@fabiolafucile ti vedo\u0027,\n",
                                                                          "   \u0027@fabiolafucile @matildefucile non ci posso fare niente, è na ntamata\u0027,\n",
                                                                          "   \u0027Vedi che pure lei ascolta demoni urbani? @fabiolafucile\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027SUPERFAN\u0027,\n",
                                                                          "  \u0027description\u0027: \"A highly dedicated and long-term follower who consistently engages with the influencer\u0027s content quickly, expressively, and often personally, sharing their reactions and appreciation.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027High total comments (11)\u0027,\n",

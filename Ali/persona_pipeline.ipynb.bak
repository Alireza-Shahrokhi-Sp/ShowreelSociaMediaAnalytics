                                                                          "[{\u0027codename\u0027: \u0027SUPERFAN\u0027,\n",
                                                                          "  \u0027label\u0027: \u0027The Superfan\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027A highly dedicated and long-term follower who comments frequently, early, and enthusiastically across a wide range of content. They express a strong personal connection and are a foundational part of the community.\u0027,\n",
                                                                          "  \u0027quantitative_signals\u0027: [\u0027High total comments (\u003e10)\u0027,\n",
                                                                          "   \u0027Very long activity span (\u003e1 year)\u0027,\n",

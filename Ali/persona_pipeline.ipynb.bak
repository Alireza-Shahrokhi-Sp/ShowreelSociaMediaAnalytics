                                                                          "   \u0027Short average word count (2)\u0027,\n",
                                                                          "   \u0027Comments on relatable, slightly exasperated content\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@pyfrancy adoroooooo\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027ENGAGED_QUESTIONER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona shows sustained interest over time, asks direct questions to the influencer, and engages with product-related or interactive content.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Long activity span (264 days)\u0027,\n",

                                                                          "  \u0027examples\u0027: [\u0027@sofiagallo98 @sofia103341 @alisya29131\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027DIRECT_RESPONDER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user directly answers explicit calls to action or questions posed by the influencer in their captions.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: low\u0027,\n",

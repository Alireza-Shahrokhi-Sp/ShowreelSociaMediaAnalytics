                                                                          " {\u0027codename\u0027: \u0027THE REACTIVE FAN\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This persona is a quick and highly emotional responder, using abundant emojis to convey laughter or strong agreement, and engaging with humorous or relatable content.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Very early commenter (\u003c1h, often \u003c0.5h)\u0027,\n",
                                                                          "   \u0027High emoji rate (100%)\u0027,\n",
                                                                          "   \u0027Short, impactful comments\u0027,\n",
                                                                          "   \u0027Engages with humorous reels or pop culture discussions\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Muoio 😂😂😂😂😂😂😂😂\u0027,\n",
                                                                          "   \"Si guardata tutta sta serie! Io l\u0027ho trovata originale 👏\",\n",
                                                                          "   \u0027@alicelikeaudrey ho pensato la stessa cosa 😂😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE LOYAL ADMIRER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This persona consistently expresses appreciation and admiration for the influencer, often using simple, heartfelt phrases and emojis, and engaging with posts showcasing the influencer\u0027s style or personal life.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Longer activity span (e.g., 350 days)\u0027,\n",
                                                                          "   \u0027Consistent, positive sentiment\u0027,\n",
                                                                          "   \u0027Moderate to high emoji rate\u0027,\n",
                                                                          "   \"Engages with posts highlighting the influencer\u0027s appearance or personal reflections\"],\n",
                                                                          "  \u0027examples\u0027: [\u0027La regina dei boschi in autunno😘\u0027,\n",
                                                                          "   \u0027La regina dei boschi autunna\u0027,\n",
                                                                          "   \u0027😍\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027CASUAL_APPRECIATOR\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user expresses simple, non-verbal appreciation for content, often using only emojis.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 0\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Low total comments (1-2)\u0027,\n",
                                                                          "   \u0027Engages with general content (selfies, personal updates).\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027🙌\u0027, \u0027🙌\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027PRODUCT_ENGAGER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user shows interest in the influencer\u0027s product collaborations, often confirming prior knowledge or expressing positive sentiment.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Engages with sponsored/product launch posts\u0027,\n",
                                                                          "   \u0027Comments are short, positive, and often include emojis\u0027,\n",
                                                                          "   \u0027May comment later, but shows specific product awareness.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Sì, li avevo visti 😍\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027AFFILIATE_SHARER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user tags friends in comments to share content, often expressing affection or drawing attention to the post.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Tags other users in comments\u0027,\n",
                                                                          "   \u0027Comments are short and direct\u0027,\n",
                                                                          "   \u0027High emoji rate\u0027,\n",
                                                                          "   \u0027Engages with lighthearted or viral content.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@silviascartozzoni ti voglio vedere💕\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027COMMUNITY_RESPONDER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user primarily engages by replying to other comments or the influencer, often with short, affirmative, and supportive messages.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Reply ratio: 100%\u0027,\n",
                                                                          "   \u0027Low avg word count (2-4)\u0027,\n",
                                                                          "   \u0027Uses emojis for emphasis\u0027,\n",
                                                                          "   \u0027Engages across a longer activity span, but comments are infrequent.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@camilla.moro siiiii!!!\u0027, \u0027@camilla.moro siiii😍\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027ACTIVE_FAN\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user is a highly engaged and consistent follower, commenting frequently and early, often with humorous or relatable observations.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027High total comments (10+)\u0027,\n",
                                                                          "   \u0027High early commenter rate (\u003e60%)\u0027,\n",
                                                                          "   \u0027Long activity span (\u003e1000 days)\u0027,\n",
                                                                          "   \u0027High emoji rate (\u003e90%)\u0027,\n",
                                                                          "   \"Comments are conversational, often referencing influencer\u0027s personality or past content.\"],\n",
                                                                          "  \u0027examples\u0027: [\u0027Silver Button di YT in 3… 2… 1… eccolo! 😂\u0027,\n",
                                                                          "   \u0027Vi prego 😫 @claudiodibiagio\u0027,\n",
                                                                          "   \u0027@camihawke devi farti una cultura di Superman ora, per forza 😍😂\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE CONNECTOR\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user primarily engages by tagging friends in comments, often with short, direct messages, indicating shared interests or inside jokes related to the post\u0027s content.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 3\u0027,\n",
                                                                          "   \u0027Emoji rate: 0-5%\u0027,\n",
                                                                          "   \u0027Reply ratio: 0-16%\u0027,\n",
                                                                          "   \u0027High early commenter rate (84-100%)\u0027,\n",
                                                                          "   \u0027Comments often contain only a tag or a tag with a brief remark.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027@valentinapannullo tipo noi\u0027,\n",
                                                                          "   \"@_farna t\u0027ho taggata apposta\",\n",
                                                                          "   \u0027@alebartolii\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE EMPATHIZER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user connects deeply with the influencer\u0027s personal narratives and emotions, expressing strong agreement, sharing personal feelings, and using emojis to convey their sentiment.\",\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 24\u0027,\n",
                                                                          "   \u0027Emoji rate: 100%\u0027,\n",
                                                                          "   \u0027Question rate: 50%\u0027,\n",
                                                                          "   \u0027Early commenter (\u003c1h): 100%\u0027,\n",
                                                                          "   \u0027Engages with posts about personal reflections, feelings, or relatable life situations.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\u0027Il mare e la persona preferita ❤️ condivido questa idea di felicità 🌈\u0027,\n",
                                                                          "   \u0027Siamo nati stanchi, perché fa freddo a febbraio e a Marzo, si dovrebbe essere in letargo in quel periodo, giusto??\u0027,\n",
                                                                          "   \u0027Testa tra le nuvole, perennemente. Sensibili anche troppo. Dacci dentro, aspetto da un po’ questo oroscopo 😎😎😎\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027THE ANALYST\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user provides thoughtful, detailed comments, often offering their perspective or advice on the topic presented in the post, even if commenting later.\u0027,\n",
                                                                          "  \u0027signals\u0027: [\u0027Avg word count: 31\u0027,\n",
                                                                          "   \u0027Emoji rate: 0%\u0027,\n",
                                                                          "   \u0027Question rate: 0%\u0027,\n",
                                                                          "   \u0027Lower early commenter rate (0%)\u0027,\n",
                                                                          "   \u0027Engages with posts discussing specific topics or personal challenges.\u0027],\n",
                                                                          "  \u0027examples\u0027: [\"Fare sport significa tutto e niente. C\u0027è dentro il rugby e il nuoto.\",\n",
                                                                          "   \u0027Potenziare i muscoli, ridurre l infiammazione, ciclizzare recupero e performance ē tutto un altro film.\u0027,\n",
                                                                          "   \u0027Bello da girare.\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027LATE_ADMIRER\u0027,\n",
                                                                          "  \u0027description\u0027: \u0027This user leaves simple, appreciative comments, often on aesthetic posts, but with a significant delay, suggesting casual browsing or discovery.\u0027,\n",

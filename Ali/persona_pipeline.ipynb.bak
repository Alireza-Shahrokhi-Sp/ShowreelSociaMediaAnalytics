                                                                          "  \u0027examples\u0027: [\u0027@liviaarosati diribbi\u0027, \u0027@liviaarosati noi come Cami\u0027]},\n",
                                                                          " {\u0027codename\u0027: \u0027APPRECIATIVE_OBSERVER\u0027,\n",
                                                                          "  \u0027description\u0027: \"This user offers simple, positive affirmations or compliments on the influencer\u0027s work or content.\",\n",
